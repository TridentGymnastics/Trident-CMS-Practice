---
import { Image } from 'astro:assets';
import { announcements } from '../data/announcements';

export interface Props {
  /** Cap how many show (homepage). Omit to show all (the What's Happening page). */
  limit?: number;
  /** Show a "See all updates" link through to /whats-happening. */
  showViewAll?: boolean;
  /** Section heading. Pass null to render the list with no heading (dedicated page
   *  supplies its own <h1>). */
  heading?: string | null;
  /** Sub-line under the heading. Pass null to hide. */
  intro?: string | null;
}

const {
  limit,
  showViewAll = false,
  heading = "What's happening at Trident",
  intro = 'The latest news, wins and moments from around the gym.',
} = Astro.props;

// Newest first. Staff must explicitly switch an update on to publish it.
const all = announcements
  .filter((a) => a.live === true)
  .sort((a, b) => Date.parse(b.dateISO) - Date.parse(a.dateISO));

const items = typeof limit === 'number' ? all.slice(0, limit) : all;
const headingId = heading ? 'announcements-heading' : undefined;
---

{items.length > 0 && (
  <section
    class="announcements section"
    id="whats-happening"
    aria-labelledby={headingId}
    aria-label={heading ? undefined : "What's happening at Trident"}
  >
    <div class="container">
      {heading && <h2 id={headingId}>{heading}</h2>}
      {intro && <p class="section-intro">{intro}</p>}

      <div class="announcements__list">
        {items.map((item) => (
          <article class="announcement card card-accent">
            <div class="announcement__meta">
              {item.tag && <span class="announcement__tag">{item.tag}</span>}
              <span class="announcement__date">{item.date}</span>
            </div>
            <h2 class="announcement__title">{item.title}</h2>
            <div class="announcement__body">
              {item.body.map((para) => <p>{para}</p>)}
            </div>

            {item.images && item.images.length > 0 && (
              <div class:list={["announcement__gallery", `announcement__gallery--${Math.min(item.images.length, 3)}`]}>
                {item.images.map((photo) => (
                  <figure class="announcement__figure">
                    <Image
                      class="announcement__photo"
                      src={photo.src}
                      alt={photo.alt}
                      width={960}
                      height={1280}
                      widths={[360, 640, 960]}
                      sizes="(max-width: 640px) 88vw, 320px"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>

      {showViewAll && (
        <p class="announcements__viewall">
          <a href="/whats-happening">See all updates
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
        </p>
      )}
    </div>
  </section>
)}

<style>
  .announcements h2 {
    text-align: center;
    margin-bottom: 8px;
  }

  .announcements .section-intro {
    text-align: center;
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0 auto 2rem;
  }

  .announcements__list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 820px;
    margin: 0 auto;
  }

  /* .card supplies padding / radius / shadow. */
  .announcement {
    text-align: left;
  }

  .announcement__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }

  .announcement__tag {
    background: var(--accent-yellow);
    color: var(--dark-navy);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
  }

  .announcement__date {
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .announcement__title {
    color: var(--dark-navy);
    font-size: 1.5rem;
    line-height: 1.25;
    margin: 0 0 0.75rem;
  }

  .announcement__body p {
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 0.85rem;
  }

  .announcement__body p:last-child {
    margin-bottom: 0;
  }

  /* Photo gallery — portraits (3:4) so no faces get cropped. Centred in the card. */
  /* width:fit-content shrinks the grid to exactly its columns, then margin-inline
     auto centres that block in the card — reliable regardless of card width. */
  .announcement__gallery {
    display: grid;
    gap: 0.85rem;
    margin: 1.5rem auto 0;
    width: fit-content;
    max-width: 100%;
    justify-content: center;
  }

  .announcement__gallery--1 {
    grid-template-columns: minmax(0, 340px);
    max-width: 340px;
  }

  .announcement__gallery--2 {
    grid-template-columns: repeat(2, minmax(0, 300px));
    max-width: 640px;
  }

  .announcement__gallery--3 {
    grid-template-columns: repeat(2, minmax(0, 300px));
    max-width: 640px;
  }

  .announcement__figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-1);
    background: var(--light-bg);
  }

  .announcement__photo {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .announcements__viewall {
    text-align: center;
    margin: 2rem 0 0;
  }

  .announcements__viewall a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--primary-blue);
  }

  .announcements__viewall a:hover {
    color: var(--dark-navy);
  }

  @media (min-width: 700px) {
    .announcement__gallery--3 {
      grid-template-columns: repeat(3, minmax(0, 220px));
      max-width: 720px;
    }
  }

  /* Mobile: one photo per row so celebration shots are large, not thumbnails. */
  @media (max-width: 640px) {
    .announcement__title {
      font-size: 1.3rem;
    }

    .announcement__gallery--2,
    .announcement__gallery--3 {
      grid-template-columns: minmax(0, 360px);
      max-width: 360px;
    }
  }
</style>
