---
import { programNames as names } from '../data/programContent';
import AutumnLeafField from './AutumnLeafField.astro';
---

<section class="autumn-promo" aria-labelledby="autumn-holiday-title">
  <div class="autumn-promo__frame">
    <AutumnLeafField />

    <div class="autumn-promo__content">
      <h2 id="autumn-holiday-title" class="autumn-promo__title">
        <span class="autumn-promo__script">Autumn</span>
        <span class="autumn-promo__title-line">Holiday Program</span>
      </h2>

      <div class="autumn-promo__chips">
        <p class="autumn-promo__chip autumn-promo__chip--date">7th-17th April 2026</p>
        <a
          class="autumn-promo__chip autumn-promo__chip--status autumn-promo__chip-link"
          href="https://portal.iclasspro.com/trident/camps/9?sortBy=name"
          target="_blank"
          rel="noopener"
        >
          Bookings Open Now
        </a>
      </div>

      <p class="autumn-promo__summary">{names.playgym}, OpenGym and Skill Workshops</p>

      <a class="btn autumn-promo__cta" href="/school-holidays">Explore Now</a>
    </div>
  </div>
</section>

<style>
  .autumn-promo {
    padding: 1.5rem 0 2rem;
  }

  .autumn-promo__frame {
    position: relative;
    overflow: hidden;
    padding: clamp(2.75rem, 5vw, 4.5rem) clamp(1.25rem, 4vw, 3rem) clamp(3.75rem, 6.5vw, 4.75rem);
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(circle at 50% 12%, rgba(255, 214, 96, 0.16), transparent 28%),
      radial-gradient(circle at 14% 82%, rgba(255, 134, 33, 0.12), transparent 26%),
      radial-gradient(circle at 88% 24%, rgba(255, 154, 46, 0.12), transparent 22%),
      linear-gradient(135deg, #07184d 0%, #0d2764 48%, #081844 100%);
    box-shadow: 0 24px 60px rgba(8, 18, 58, 0.28);
    isolation: isolate;
  }

  .autumn-promo__frame::before,
  .autumn-promo__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .autumn-promo__frame::before {
    background:
      radial-gradient(circle at 8% 28%, rgba(255, 255, 255, 0.28) 0 1px, transparent 1.5px),
      radial-gradient(circle at 18% 72%, rgba(255, 211, 56, 0.28) 0 1px, transparent 1.5px),
      radial-gradient(circle at 28% 18%, rgba(255, 255, 255, 0.18) 0 1px, transparent 1.5px),
      radial-gradient(circle at 74% 20%, rgba(255, 211, 56, 0.24) 0 1px, transparent 1.5px),
      radial-gradient(circle at 84% 66%, rgba(255, 255, 255, 0.2) 0 1px, transparent 1.5px),
      radial-gradient(circle at 92% 34%, rgba(255, 211, 56, 0.18) 0 1px, transparent 1.5px);
    opacity: 0.85;
  }

  .autumn-promo__frame::after {
    background:
      radial-gradient(circle at 50% 44%, rgba(255, 158, 32, 0.18), transparent 24%),
      radial-gradient(circle at 50% 46%, rgba(255, 255, 255, 0.08), transparent 18%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 18%),
      linear-gradient(0deg, rgba(255, 190, 48, 0.18), transparent 24%);
    mix-blend-mode: screen;
  }

  .autumn-promo__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    gap: 1rem;
  }

  .autumn-promo__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    line-height: 0.92;
  }

  .autumn-promo__script {
    font-family: "Brush Script MT", "Segoe Script", "Snell Roundhand", "Apple Chancery", "URW Chancery L", cursive;
    font-size: clamp(3.15rem, 9vw, 6.2rem);
    font-weight: 700;
    color: #fff6cf;
    letter-spacing: 0.01em;
    text-shadow:
      0 4px 0 rgba(139, 57, 0, 0.34),
      0 10px 22px rgba(12, 19, 54, 0.32);
  }

  .autumn-promo__title-line {
    margin-top: 0.35rem;
    font-size: clamp(1.45rem, 3.6vw, 2.85rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #ffffff;
    text-shadow: 0 8px 22px rgba(12, 19, 54, 0.24);
  }

  .autumn-promo__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
  }

  .autumn-promo__chip {
    margin: 0;
    border-radius: 999px;
    font-weight: 800;
    letter-spacing: 0.01em;
    box-shadow: 0 10px 24px rgba(10, 18, 54, 0.18);
  }

  .autumn-promo__chip-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  }

  .autumn-promo__chip-link:hover {
    transform: translateY(-2px);
    filter: saturate(1.03);
    box-shadow: 0 14px 28px rgba(10, 18, 54, 0.24);
  }

  .autumn-promo__chip-link:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.9);
    outline-offset: 3px;
  }

  .autumn-promo__chip--date {
    padding: 0.75rem 1.25rem;
    color: #ffe891;
    background: linear-gradient(180deg, rgba(24, 57, 127, 0.92), rgba(13, 34, 90, 0.92));
    border: 1px solid rgba(255, 211, 56, 0.32);
    font-size: clamp(1rem, 2vw, 1.45rem);
  }

  .autumn-promo__chip--status {
    padding: 0.85rem 1.35rem;
    color: #0d215c;
    background: linear-gradient(180deg, #ffe27d 0%, #ffc72c 100%);
    font-size: clamp(1rem, 1.8vw, 1.3rem);
  }

  .autumn-promo__summary {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.7rem);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 8px 20px rgba(8, 18, 58, 0.24);
  }

  .autumn-promo__cta {
    margin-top: 0.35rem;
    padding-inline: 2rem;
    background: linear-gradient(180deg, #ffe792 0%, #ffd338 52%, #efb90e 100%);
    color: #0f225c;
    font-weight: 800;
    box-shadow:
      0 14px 28px rgba(255, 174, 17, 0.24),
      0 5px 16px rgba(9, 20, 61, 0.18);
  }

  .autumn-promo__cta:hover {
    background: linear-gradient(180deg, #fff1b2 0%, #ffd338 52%, #e8b100 100%);
    color: #0b1c4d;
  }

  @media (max-width: 900px) {
    .autumn-promo {
      padding-top: 1.25rem;
    }

    .autumn-promo__frame {
      border-radius: 24px;
      padding-inline: 1rem;
    }

    .autumn-promo__summary {
      max-width: 26rem;
    }
  }

  @media (max-width: 640px) {
    .autumn-promo {
      padding-top: 1rem;
      padding-bottom: 1.5rem;
    }

    .autumn-promo__frame {
      padding: 2.5rem 1rem 3.5rem;
      border-radius: 22px;
    }

    .autumn-promo__chips {
      gap: 0.7rem;
    }

    .autumn-promo__chip--date,
    .autumn-promo__chip--status {
      width: 100%;
      max-width: 17rem;
      text-align: center;
    }

    .autumn-promo__summary {
      max-width: 18rem;
      font-size: 1rem;
    }
  }
</style>
