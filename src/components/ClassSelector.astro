---
// ClassSelector.astro
// Guided class finder modal with dynamic iClassPro class linking.
---

<div id="cs-overlay" class="cs-overlay" role="dialog" aria-modal="true" aria-label="Guided class finder" hidden>
  <div class="cs-backdrop" id="cs-backdrop"></div>

  <div class="cs-modal">
    <div class="cs-header">
      <button class="cs-back" id="cs-back" aria-label="Go back" hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        Back
      </button>

      <div class="cs-header-meta">
        <p class="cs-header-label">Guided class finder</p>
        <div class="cs-header-progress">
          <span class="cs-step-counter" id="cs-step-counter"></span>
          <div class="cs-step-dots" id="cs-step-dots" aria-hidden="true">
            <span class="cs-step-dot"></span>
            <span class="cs-step-dot"></span>
            <span class="cs-step-dot"></span>
          </div>
        </div>
      </div>

      <button class="cs-close" id="cs-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="cs-body" id="cs-body" aria-live="polite" aria-atomic="true"></div>
  </div>
</div>

<style is:global>
  .cs-overlay {
    --cs-surface: #f6f9ff;
    --cs-surface-strong: #ffffff;
    --cs-surface-soft: #edf4ff;
    --cs-border: rgba(21, 25, 87, 0.1);
    --cs-border-strong: rgba(21, 115, 194, 0.24);
    --cs-ink: var(--dark-navy, #151957);
    --cs-muted: #5f6b7b;
    --cs-muted-strong: #3a4554;
    --cs-accent: var(--primary-blue, #1573c2);
    --cs-accent-soft: rgba(21, 115, 194, 0.08);
    --cs-gold: #ffd338;
    --cs-deep: #07184d;
    --cs-cyan: #4cc6ff;
    --cs-pill: var(--primary-blue, #1573c2);
    --cs-pill-strong: #1164ab;
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .cs-overlay[hidden] {
    display: none;
  }

  .cs-backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 10%, rgba(76, 198, 255, 0.28), transparent 26%),
      radial-gradient(circle at 84% 84%, rgba(255, 211, 56, 0.2), transparent 28%),
      rgba(4, 11, 37, 0.76);
    backdrop-filter: blur(14px);
  }

  .cs-modal {
    position: relative;
    z-index: 1;
    width: min(100%, 43rem);
    max-height: min(92vh, 58rem);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.42);
    background: var(--cs-surface);
    box-shadow: 0 36px 92px rgba(4, 11, 37, 0.36);
  }

  .cs-modal::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(circle at 14% -10%, rgba(76, 198, 255, 0.16), transparent 30%),
      radial-gradient(circle at 98% 12%, rgba(255, 211, 56, 0.22), transparent 24%);
  }

  .cs-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 0.75rem;
    padding: 1rem 1rem 0.95rem;
    background:
      linear-gradient(135deg, rgba(7, 24, 77, 0.98) 0%, rgba(13, 39, 100, 0.98) 100%);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cs-back,
  .cs-close {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2.5rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease,
      transform 0.18s ease;
  }

  .cs-back {
    padding: 0.5rem 0.9rem 0.5rem 0.75rem;
    font-size: 0.86rem;
    font-weight: 600;
  }

  .cs-back:hover,
  .cs-close:hover {
    background: rgba(255, 255, 255, 0.72);
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--cs-ink);
    transform: translateY(-1px);
  }

  .cs-back[hidden] {
    visibility: hidden;
    pointer-events: none;
  }

  .cs-close {
    width: 2.5rem;
    padding: 0;
  }

  .cs-header-meta {
    min-width: 0;
    padding-top: 0.18rem;
  }

  .cs-header-label {
    margin: 0 0 0.3rem;
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cs-header-progress {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .cs-step-counter {
    color: #fff;
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .cs-step-dots {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .cs-step-dot {
    width: 1.3rem;
    height: 0.24rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    transition: background 0.22s ease, transform 0.22s ease, opacity 0.22s ease;
  }

  .cs-step-dot.is-complete,
  .cs-step-dot.is-current {
    background: var(--cs-gold);
  }

  .cs-step-dot.is-current {
    transform: scaleX(1.08);
  }

  .cs-body {
    position: relative;
    overflow-y: auto;
    padding: 1.1rem;
    background:
      radial-gradient(circle at top left, rgba(21, 115, 194, 0.1), transparent 28%),
      linear-gradient(180deg, #f7fbff 0%, #ffffff 100%);
  }

  .cs-question,
  .cs-outcome {
    animation: cs-panel-in 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes cs-panel-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cs-stage {
    display: grid;
    gap: 1rem;
  }

  .cs-stage-hero,
  .cs-result-hero {
    position: relative;
    overflow: hidden;
    padding: 1.25rem;
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at top right, rgba(255, 211, 56, 0.26), transparent 32%),
      linear-gradient(135deg, #07184d 0%, #12357c 100%);
    color: #fff;
  }

  .cs-stage-hero::after,
  .cs-result-hero::after {
    content: "";
    position: absolute;
    right: -3.2rem;
    bottom: -4.2rem;
    width: 11rem;
    height: 11rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(76, 198, 255, 0.2) 0%, rgba(76, 198, 255, 0) 72%);
    pointer-events: none;
  }

  .cs-q-kicker,
  .cs-result-eyebrow {
    margin: 0 0 0.55rem;
    color: var(--cs-accent);
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cs-q-title,
  .cs-outcome-program {
    margin: 0;
    color: var(--cs-ink);
    font-size: clamp(1.55rem, 5vw, 2.15rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .cs-q-subtitle,
  .cs-outcome-desc,
  .cs-outcome-age {
    margin: 0;
    color: var(--cs-muted);
    font-size: 0.97rem;
    line-height: 1.62;
  }

  .cs-q-subtitle,
  .cs-outcome-age {
    margin-top: 0.45rem;
  }

  .cs-stage-hero .cs-q-kicker,
  .cs-result-hero .cs-result-eyebrow {
    color: rgba(255, 255, 255, 0.66);
  }

  .cs-stage-hero .cs-q-title,
  .cs-result-hero .cs-outcome-program {
    color: #fff;
    max-width: 22ch;
  }

  .cs-stage-hero .cs-q-subtitle,
  .cs-result-hero .cs-outcome-desc {
    color: rgba(255, 255, 255, 0.76);
    max-width: 34rem;
  }

  .cs-step-note {
    margin: 1rem 0 1.1rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid rgba(21, 115, 194, 0.12);
    border-left: 3px solid rgba(21, 115, 194, 0.42);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.72);
    color: var(--cs-muted-strong);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .cs-choices {
    display: grid;
    gap: 0.75rem;
  }

  .cs-choice-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cs-choice {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 8rem;
    padding: 1rem;
    text-align: left;
    border: 1px solid rgba(21, 25, 87, 0.1);
    border-radius: 1.3rem;
    background:
      radial-gradient(circle at top right, rgba(21, 115, 194, 0.08), transparent 38%),
      linear-gradient(180deg, #ffffff 0%, #f2f7ff 100%);
    box-shadow: 0 14px 34px rgba(8, 14, 44, 0.08);
    cursor: pointer;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }

  .cs-choice::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.34rem;
    background: linear-gradient(180deg, var(--cs-cyan), var(--cs-gold));
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .cs-choice:hover {
    transform: translateY(-2px);
    border-color: rgba(21, 115, 194, 0.24);
    background:
      radial-gradient(circle at top right, rgba(255, 211, 56, 0.14), transparent 38%),
      linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    box-shadow: 0 18px 38px rgba(8, 14, 44, 0.12);
  }

  .cs-choice:hover::before {
    opacity: 1;
  }

  .cs-choice[data-tone="secondary"] {
    background: rgba(255, 255, 255, 0.52);
    box-shadow: none;
  }

  .cs-choice-topline {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--cs-accent);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cs-choice-label {
    display: block;
    color: var(--cs-ink);
    font-size: 1.04rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: -0.012em;
  }

  .cs-choice-sub {
    display: block;
    margin-top: 0.18rem;
    color: var(--cs-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .cs-choice-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.9rem;
    padding: 0.38rem 0.75rem;
    border-radius: 999px;
    background: rgba(21, 115, 194, 0.08);
    color: var(--cs-ink);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .cs-result-panel {
    display: grid;
    gap: 0.72rem;
  }

  .cs-result-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .cs-result-topline .cs-result-eyebrow {
    margin-bottom: 0;
  }

  .cs-program-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.42rem 0.72rem;
    border-radius: 999px;
    background: rgba(103, 160, 215, 0.2);
    color: rgba(255, 255, 255, 0.95);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1.5px solid rgba(103, 160, 215, 0.4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .cs-outcome-age {
    margin-top: 0.35rem;
  }

  .cs-outcome-desc {
    margin-top: 0.95rem;
    color: var(--cs-muted-strong);
  }

  .cs-result-grid {
    display: grid;
    gap: 0.55rem;
  }

  .cs-result-detail {
    padding: 0.85rem;
    border: 1px solid rgba(21, 25, 87, 0.09);
    border-radius: 1rem;
    background:
      radial-gradient(circle at top right, rgba(21, 115, 194, 0.08), transparent 34%),
      #fff;
    box-shadow: 0 12px 30px rgba(8, 14, 44, 0.07);
  }

  .cs-result-detail-label {
    margin: 0 0 0.5rem;
    color: var(--cs-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cs-result-detail-value {
    margin: 0;
    color: var(--cs-ink);
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .cs-result-detail-days {
    grid-column: 1 / -1;
  }

  .cs-day-pills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5.75rem, 1fr));
    gap: 0.4rem;
  }

  .cs-day-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.32rem;
    width: 100%;
    min-height: 2.45rem;
    padding: 0.5rem 0.72rem;
    border-radius: 999px;
    border: 1.5px solid rgba(21, 25, 87, 0.14);
    background: #fff;
    color: var(--cs-ink);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(8, 14, 44, 0.06);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease,
      box-shadow 0.15s ease,
      color 0.15s ease;
  }

  .cs-day-pill:hover {
    border-color: var(--cs-pill);
    background: rgba(21, 115, 194, 0.06);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(21, 115, 194, 0.14);
  }

  .cs-day-pill.is-selected {
    border-color: var(--cs-pill);
    background: var(--cs-pill);
    color: #fff;
    box-shadow:
      0 4px 14px rgba(21, 115, 194, 0.35),
      0 0 0 3px rgba(21, 115, 194, 0.14);
    transform: translateY(-1px);
    font-weight: 800;
  }

  .cs-day-pill.is-selected:hover {
    background: var(--cs-pill-strong);
    box-shadow: 0 6px 18px rgba(21, 115, 194, 0.4);
  }

  .cs-day-picker-hint {
    margin: 0.5rem 0 0;
    color: var(--cs-muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .cs-session-preview {
    display: grid;
    grid-template-columns: minmax(8rem, 0.8fr) minmax(0, 1.7fr);
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.65rem;
    padding: 0.72rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(21, 115, 194, 0.13);
    background: rgba(21, 115, 194, 0.055);
  }

  .cs-session-preview-head {
    display: grid;
    gap: 0.16rem;
    min-width: 0;
    margin: 0;
  }

  .cs-session-preview-label,
  .cs-time-card-day {
    margin: 0;
  }

  .cs-session-preview-label {
    color: var(--cs-muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cs-time-card-day {
    color: var(--cs-ink);
    font-size: 1rem;
    font-weight: 800;
  }

  .cs-session-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.36rem;
    min-width: 0;
  }

  .cs-session-time {
    display: inline-flex;
    align-items: center;
    min-height: 1.95rem;
    padding: 0.34rem 0.62rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(21, 25, 87, 0.1);
    color: var(--cs-ink);
    font-size: 0.78rem;
    font-weight: 800;
    box-shadow: 0 1px 3px rgba(8, 14, 44, 0.05);
  }

  .cs-time-card-time {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .cs-session-note {
    grid-column: 1 / -1;
    margin: -0.18rem 0 0;
    color: var(--cs-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .cs-outcome-note {
    margin-top: 0.9rem;
    border-radius: 1rem;
    padding: 0.95rem 1rem;
    border: 1px solid rgba(21, 115, 194, 0.12);
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 10px 24px rgba(8, 14, 44, 0.05);
  }

  .cs-outcome-note-title {
    margin: 0 0 0.25rem;
    color: var(--cs-ink);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cs-outcome-note-copy {
    margin: 0;
    color: var(--cs-muted-strong);
    font-size: 0.86rem;
    line-height: 1.58;
  }

  .cs-outcome-actions {
    display: grid;
    gap: 0.65rem;
    padding: 0.95rem;
    border: 1px solid rgba(21, 25, 87, 0.08);
    border-radius: 1.35rem;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 12px 30px rgba(8, 14, 44, 0.06);
  }

  .cs-btn-primary,
  .cs-btn-secondary,
  .cs-restart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border-radius: 999px;
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      background 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .cs-btn-primary {
    padding: 1rem 1.3rem;
    border: none;
    background: linear-gradient(180deg, #ffe792 0%, var(--cs-gold) 100%);
    color: var(--cs-ink);
    box-shadow: 0 10px 24px rgba(255, 174, 17, 0.26);
    cursor: pointer;
  }

  .cs-btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 32px rgba(255, 174, 17, 0.34);
    filter: saturate(1.06) brightness(1.02);
  }

  .cs-btn-primary:disabled,
  .cs-btn-primary[aria-disabled="true"] {
    background: #e5e7eb;
    color: #6b7280;
    box-shadow: none;
    cursor: not-allowed;
  }

  .cs-btn-primary:disabled:hover,
  .cs-btn-primary[aria-disabled="true"]:hover {
    transform: none;
    box-shadow: none;
  }

  .cs-btn-secondary {
    padding: 0.9rem 1.25rem;
    border: 1px solid rgba(21, 25, 87, 0.12);
    background: rgba(7, 24, 77, 0.04);
    color: var(--cs-ink);
  }

  .cs-btn-secondary:hover {
    transform: translateY(-1px);
    border-color: rgba(21, 115, 194, 0.22);
    background: rgba(255, 255, 255, 0.92);
  }

  .cs-restart {
    min-height: auto;
    padding: 0.25rem;
    border: none;
    background: transparent;
    color: var(--cs-muted);
    cursor: pointer;
    justify-content: center;
  }

  .cs-restart:hover {
    color: var(--cs-ink);
  }

  .cs-back:focus-visible,
  .cs-close:focus-visible,
  .cs-choice:focus-visible,
  .cs-day-pill:focus-visible,
  .cs-btn-primary:focus-visible,
  .cs-btn-secondary:focus-visible,
  .cs-restart:focus-visible {
    outline: none;
    border-color: rgba(21, 115, 194, 0.35);
    box-shadow: 0 0 0 4px rgba(21, 115, 194, 0.16);
  }

  /* ── Result reveal animations ──────────────────────────────────────────── */

  @keyframes cs-stamp {
    from { opacity: 0; transform: scale(1.18) translateY(6px); }
    to   { opacity: 1; transform: scale(1)    translateY(0);   }
  }

  @keyframes cs-fade-up {
    from { opacity: 0; transform: translateY(7px); }
    to   { opacity: 1; transform: translateY(0);   }
  }

  @keyframes cs-pop {
    from { opacity: 0; transform: scale(0.6); }
    to   { opacity: 1; transform: scale(1);   }
  }

  .cs-result-hero.is-reveal .cs-result-eyebrow {
    animation: cs-fade-up 0.28s ease 0.18s both;
  }

  .cs-result-hero.is-reveal .cs-program-chip {
    animation: cs-pop 0.38s cubic-bezier(0.34, 1.56, 0.64, 1) 0.22s both;
  }

  .cs-result-hero.is-reveal .cs-outcome-program {
    animation: cs-stamp 0.52s cubic-bezier(0.34, 1.56, 0.64, 1) 0.28s both;
  }

  .cs-result-hero.is-reveal .cs-outcome-desc {
    animation: cs-fade-up 0.35s ease 0.48s both;
  }

  /* Hero flash — golden burst behind the text on first reveal */
  .cs-result-hero.is-reveal::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(ellipse at 50% 40%, rgba(255, 211, 56, 0.55) 0%, rgba(255, 255, 255, 0.18) 40%, transparent 72%);
    pointer-events: none;
    animation: cs-flash 0.9s ease-out 0.26s both;
  }

  @keyframes cs-flash {
    0%   { opacity: 0; }
    18%  { opacity: 1; }
    100% { opacity: 0; }
  }

  /* "YOUR CLASS IS" gold label above the class name */
  .cs-match-label {
    margin: 0.65rem 0 0.05rem;
    color: var(--cs-gold);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .cs-result-hero.is-reveal .cs-match-label {
    animation: cs-fade-up 0.28s ease 0.22s both;
  }

  /* Finding transition — spinner screen */
  .cs-finding {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 20rem;
    gap: 1.5rem;
    animation: cs-fade-up 0.22s ease both;
  }

  .cs-finding-ring {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 3px solid rgba(21, 115, 194, 0.1);
    border-top-color: var(--cs-gold);
    border-right-color: var(--cs-accent);
    animation: cs-spin 0.7s linear infinite;
  }

  .cs-finding-label {
    margin: 0;
    color: var(--cs-muted-strong);
    font-size: 0.94rem;
    font-weight: 600;
  }

  @keyframes cs-spin {
    to { transform: rotate(360deg); }
  }

  /* ── CTA nudge — draws attention after confetti settles ─────────────────── */

  @keyframes cs-nudge {
    0%   { transform: scale(1)    translateY(0);    box-shadow: 0 10px 24px rgba(255, 174, 17, 0.26); }
    22%  { transform: scale(1.05) translateY(-3px); box-shadow: 0 18px 36px rgba(255, 174, 17, 0.48); }
    44%  { transform: scale(1)    translateY(0);    box-shadow: 0 10px 24px rgba(255, 174, 17, 0.26); }
    66%  { transform: scale(1.03) translateY(-2px); box-shadow: 0 14px 28px rgba(255, 174, 17, 0.38); }
    88%  { transform: scale(1)    translateY(0);    box-shadow: 0 10px 24px rgba(255, 174, 17, 0.26); }
    100% { transform: scale(1)    translateY(0);    }
  }

  .cs-btn-primary.is-nudge {
    animation: cs-nudge 1.1s ease 0s 1 both;
  }

  /* ── PlayGym / preschool cross-link callout ─────────────────────────────── */

  .cs-crosslink {
    margin-top: 0.1rem;
    padding: 1rem 1.1rem 1.1rem;
    border: 1.5px solid rgba(21, 115, 194, 0.22);
    border-top: 3px solid var(--cs-accent);
    border-radius: 1rem;
    background:
      radial-gradient(circle at top right, rgba(255, 211, 56, 0.1), transparent 50%),
      rgba(21, 115, 194, 0.04);
    box-shadow: 0 6px 18px rgba(8, 14, 44, 0.06);
    text-align: center;
  }

  .cs-crosslink-title {
    margin: 0 0 0.3rem;
    color: var(--cs-ink);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cs-crosslink-copy {
    margin: 0 0 0.75rem;
    color: var(--cs-muted-strong);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .cs-crosslink-link {
    display: inline-flex;
    align-items: center;
    padding: 0.48rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid var(--cs-accent);
    background: transparent;
    color: var(--cs-accent);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .cs-crosslink-link:hover {
    background: var(--cs-accent);
    color: #fff;
    box-shadow: 0 4px 12px rgba(21, 115, 194, 0.28);
  }

  @media (min-width: 40rem) {
    .cs-header {
      padding: 1.15rem 1.25rem 1rem;
    }

    .cs-body {
      padding: 1.25rem;
    }
  }

  @media (max-width: 32rem) {
    .cs-overlay {
      padding: 0;
      align-items: flex-end;
    }

    .cs-modal {
      width: 100%;
      max-height: 96vh;
      border-radius: 1.6rem 1.6rem 0 0;
    }

    /* Keep 2-column age grid — just compact the cards */
    .cs-choice-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.55rem;
    }

    .cs-choice-grid .cs-choice {
      min-height: 4.5rem;
      padding: 0.8rem 0.75rem;
      text-align: center;
    }

    /* Strip decorative elements from grid cards on mobile to save height */
    .cs-choice-grid .cs-choice-topline,
    .cs-choice-grid .cs-choice-arrow {
      display: none;
    }

    .cs-choice-grid .cs-choice-label {
      font-size: 0.95rem;
    }

    .cs-choice-grid .cs-choice-sub {
      font-size: 0.76rem;
    }

    .cs-stage-hero,
    .cs-result-hero {
      padding: 1rem;
      border-radius: 1.2rem;
    }

    /* Header: separate back/close row from progress indicator row */
    .cs-header {
      grid-template-areas:
        "back . close"
        "meta meta meta";
      grid-template-rows: auto auto;
      padding: 0.7rem 0.85rem 0.65rem;
      gap: 0.4rem 0.5rem;
      align-items: center;
    }

    .cs-back { grid-area: back; }
    .cs-close { grid-area: close; }

    .cs-header-meta {
      grid-area: meta;
      padding-top: 0;
    }

    .cs-header-label {
      display: none;
    }

    .cs-header-progress {
      justify-content: center;
      gap: 0.65rem;
    }

    .cs-step-dot {
      width: 2.2rem;
    }

    /* Larger touch targets for day pills */
    .cs-day-pill {
      padding: 0.58rem 0.7rem;
      min-height: 2.6rem;
      font-size: 0.84rem;
    }

    .cs-session-preview {
      grid-template-columns: 1fr;
      gap: 0.55rem;
      margin-top: 0.55rem;
      padding: 0.68rem;
    }

    .cs-session-preview-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.65rem;
    }

    .cs-session-list {
      justify-content: flex-start;
    }

    .cs-session-note {
      margin-top: 0;
    }

    /* Full-width stacked actions on mobile */
    .cs-outcome-actions {
      padding: 0.75rem;
      gap: 0.5rem;
    }

    /* Safe area for notched phones */
    .cs-body {
      overscroll-behavior: contain;
      padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  import { programNames, levelName, levelTag, playgym, playgymSupervision, playgymAcceptsAgeSpan } from '../data/programContent';
  // CMS text is plain text, including inside the client-rendered wizard.
  const escapeHtml = (value: string) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  import { firePartyPopper } from '../scripts/confetti-burst';
  import {
    getClassRecommendation,
    buildIClassProUrl,
    formatDayName,
    formatClassSessionTime,
    ICLASSPRO_CLASSES_URL,
    type ClassType,
    type DayName,
    type Recommendation,
  } from '../data/classSelectorOptions';

  // ─── Types ───────────────────────────────────────────────────────────────────

  type ClassTypeOption = {
    label: string;
    sub: string;
    classType: ClassType;
  };

  type AgeBucket = {
    label: string;
    sub: string;
    // Eyebrow above the label. Most buckets are school year levels; the under-4s
    // aren't at kinder yet, so those read as ages instead.
    topline: string;
    // The real span the label promises — used to hide days a child in this bucket
    // could be refused on. See AGE_BUCKETS below.
    minAge: number;
    maxAge: number;
    ageYears: number;
    classTypes: ClassTypeOption[];
    defaultClassType?: ClassType;
  };

  type WizardStep =
    | { name: 'age' }
    | { name: 'type'; bucket: AgeBucket }
    | { name: 'result'; bucket: AgeBucket; classType: ClassType; rec: Recommendation; selectedDay: DayName | null; fresh?: boolean };

  // ─── Age buckets & class type options ────────────────────────────────────────

  const STYLE_OLDER: ClassTypeOption[] = [
    {
      label: 'Traditional gymnastics',
      sub: 'Structured progressions across floor, beam, bars, and apparatus',
      classType: 'structured',
    },
    {
      label: 'Urban / parkour style',
      sub: 'High-energy class with jumps, vaults, and urban movement skills',
      classType: 'energetic',
    },
  ];

  // Buckets are age-based on purpose. iClassPro enforces age at registration, and
  // its bands are ~14 months wide while a school year level spans ~21 months, so
  // recommending by year level would send the older half of each cohort to a class
  // that rejects them. Age 6 ≈ Grade 1, 7 ≈ Grade 2 and so on, which is why the
  // subs name the grade — the mapping still reads through, it just stays enrolable.
  // The one genuine ambiguity is age 5: kinder or Prep, Adventurers or Foundation.
  // That gets its own bucket, distinguished by school status rather than age.
  //
  // minAge/maxAge are the real span each label promises, and get passed to
  // getClassRecommendation so it can drop days whose class would reject part of it.
  // A label must never span wider than the class behind it: '3½ – 5' stops short of
  // Adventurers' 5y6m cap on purpose, so nobody is sent to a class that refuses them.
  const AGE_BUCKETS: AgeBucket[] = [
    { label: 'Under 2', sub: 'Babies and very young toddlers', topline: 'Age', minAge: 0,   maxAge: 1.99, ageYears: 1,   classTypes: [], defaultClassType: 'free-play' },
    { label: '2 – 3½',  sub: 'Toddler stage',                  topline: 'Age', minAge: 2,   maxAge: 3.49, ageYears: 3,   classTypes: [], defaultClassType: 'free-play' },
    { label: '3½ – 5',  sub: levelTag('edu_adv'),     topline: 'Age', minAge: 3.5, maxAge: 5.49, ageYears: 4.5, classTypes: [], defaultClassType: 'independent' },
    { label: '5 – 6',   sub: levelTag('edu_found'), topline: 'Age', minAge: 5,   maxAge: 6.99, ageYears: 5.8, classTypes: STYLE_OLDER },
    { label: '6',       sub: levelTag('edu_1'),                    topline: 'Age', minAge: 6,   maxAge: 6.99, ageYears: 6.5, classTypes: STYLE_OLDER },
    { label: '7',       sub: levelTag('edu_2'),                    topline: 'Age', minAge: 7,   maxAge: 7.99, ageYears: 7.5, classTypes: STYLE_OLDER },
    { label: '8',       sub: levelTag('edu_3'),                    topline: 'Age', minAge: 8,   maxAge: 8.99, ageYears: 8.5, classTypes: STYLE_OLDER },
    { label: '9',       sub: levelTag('edu_4'),                    topline: 'Age', minAge: 9,   maxAge: 9.99, ageYears: 9.2, classTypes: STYLE_OLDER },
    { label: '10 +',    sub: levelTag('edu_5'),              topline: 'Age', minAge: 10,  maxAge: 14,   ageYears: 10,  classTypes: STYLE_OLDER },
  ];

  // ─── DOM refs ─────────────────────────────────────────────────────────────────

  const overlay  = document.getElementById('cs-overlay')  as HTMLElement;
  const bodyEl   = document.getElementById('cs-body')      as HTMLElement;
  const backBtn  = document.getElementById('cs-back')      as HTMLButtonElement;
  const closeBtn = document.getElementById('cs-close')     as HTMLButtonElement;
  const backdrop = document.getElementById('cs-backdrop')  as HTMLElement;
  const counter  = document.getElementById('cs-step-counter') as HTMLElement;
  const stepDots = Array.from(document.querySelectorAll<HTMLElement>('.cs-step-dot'));

  // ─── State ────────────────────────────────────────────────────────────────────

  let history: WizardStep[] = [];
  let currentStep: WizardStep = { name: 'age' };

  // ─── Progress UI ──────────────────────────────────────────────────────────────

  function updateProgress() {
    const isResult = currentStep.name === 'result';
    const isType   = currentStep.name === 'type';

    stepDots.forEach((dot, i) => {
      dot.classList.remove('is-complete', 'is-current');
      if (isResult) {
        dot.classList.add('is-complete');
      } else if (isType) {
        if (i === 0) dot.classList.add('is-complete');
        if (i === 1) dot.classList.add('is-current');
      } else {
        if (i === 0) dot.classList.add('is-current');
      }
    });

    backBtn.hidden = history.length === 0;
    counter.textContent = isResult ? 'Your recommendation' : `Step ${isType ? 2 : 1} of 3`;
  }

  // ─── Focus ────────────────────────────────────────────────────────────────────

  function focusFirstInteractive() {
    requestAnimationFrame(() => {
      const target = overlay.querySelector<HTMLElement>(
        '.cs-body .cs-choice, .cs-body .cs-btn-primary:not([disabled]), .cs-body .cs-btn-secondary, .cs-body .cs-restart',
      );
      target?.focus();
    });
  }

  // ─── Finding transition ───────────────────────────────────────────────────────

  function renderFinding() {
    updateProgress();
    backBtn.hidden = true;
    bodyEl.innerHTML = `
      <div class="cs-finding">
        <div class="cs-finding-ring"></div>
        <p class="cs-finding-label">Finding your perfect class…</p>
      </div>`;
    setTimeout(renderCurrent, 420);
  }

  function openSelector() {
    history = [];
    currentStep = { name: 'age' };
    overlay.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    renderCurrent();
  }

  function closeSelector() {
    overlay.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  function goBack() {
    const prev = history.pop();
    currentStep = prev ?? { name: 'age' };
    renderCurrent();
  }

  function renderCurrent() {
    updateProgress();
    if (currentStep.name === 'age') {
      renderAgeStep();
    } else if (currentStep.name === 'type') {
      renderTypeStep(currentStep.bucket);
    } else {
      const isFirstVisit = currentStep.fresh === true;
      if (isFirstVisit) currentStep = { ...currentStep, fresh: false };
      renderResult(currentStep.rec, currentStep.selectedDay, isFirstVisit);
    }
  }

  // ─── Step 1: Age ──────────────────────────────────────────────────────────────

  function renderAgeStep() {
    bodyEl.innerHTML = `
      <section class="cs-question cs-stage">
        <div class="cs-stage-hero">
          <p class="cs-q-kicker">Guided class finder</p>
          <h2 class="cs-q-title">Find the right class</h2>
          <p class="cs-q-subtitle">How old is your child?</p>
        </div>

        <div class="cs-choices cs-choice-grid">
          ${AGE_BUCKETS.map((bucket, i) => `
            <button class="cs-choice" type="button" data-bucket-index="${i}">
              <span class="cs-choice-topline">${bucket.topline}</span>
              <span class="cs-choice-label">${bucket.label}</span>
              <span class="cs-choice-sub">${escapeHtml(bucket.sub)}</span>
              <span class="cs-choice-arrow">Select</span>
            </button>`).join('')}
        </div>
      </section>`;

    bodyEl.querySelectorAll<HTMLButtonElement>('.cs-choice').forEach((btn) => {
      btn.addEventListener('click', () => {
        const bucket = AGE_BUCKETS[Number(btn.dataset.bucketIndex)];
        if (!bucket) return;
        history.push(currentStep);
        if (bucket.classTypes.length === 0) {
          const classType = bucket.defaultClassType ?? 'free-play';
          const rec = getClassRecommendation(bucket.ageYears, classType, undefined, { max: bucket.maxAge, min: bucket.minAge });
          currentStep = { name: 'result', bucket, classType, rec, selectedDay: null, fresh: true };
          renderFinding();
        } else {
          currentStep = { name: 'type', bucket };
          renderCurrent();
        }
      });
    });

    focusFirstInteractive();
  }

  // ─── Step 2: Class type ───────────────────────────────────────────────────────

  function renderTypeStep(bucket: AgeBucket) {
    const options = [...bucket.classTypes];
    if (playgymAcceptsAgeSpan(bucket.minAge, bucket.maxAge)) {
      options.push({ label: programNames.playgym, sub: `${playgymSupervision}. Ages ${playgym.age_range}.`, classType: 'free-play' });
    }
    bodyEl.innerHTML = `
      <section class="cs-question cs-stage">
        <div class="cs-stage-hero">
          <p class="cs-q-kicker">Step 2 of 3 — Class style</p>
          <h2 class="cs-q-title">What kind of class?</h2>
          <p class="cs-q-subtitle">For age ${bucket.label} — choose the style that suits them.</p>
        </div>

        <div class="cs-choices">
          ${options.map((opt, i) => `
            <button class="cs-choice" type="button" data-type-index="${i}">
              <span class="cs-choice-topline">Class style</span>
              <span class="cs-choice-label">${escapeHtml(opt.label)}</span>
              <span class="cs-choice-sub">${escapeHtml(opt.sub)}</span>
              <span class="cs-choice-arrow">Choose style</span>
            </button>`).join('')}
        </div>
      </section>`;

    bodyEl.querySelectorAll<HTMLButtonElement>('.cs-choice').forEach((btn) => {
      btn.addEventListener('click', () => {
        const opt = options[Number(btn.dataset.typeIndex)];
        if (!opt) return;
        history.push(currentStep);
        const rec = getClassRecommendation(bucket.ageYears, opt.classType, undefined, { max: bucket.maxAge, min: bucket.minAge });
        currentStep = { name: 'result', bucket, classType: opt.classType, rec, selectedDay: null, fresh: true };
        renderFinding();
      });
    });

    focusFirstInteractive();
  }

  // ─── Result ───────────────────────────────────────────────────────────────────

  function portalUrl(rec: Recommendation, day: DayName | null): string | null {
    if (rec.levelId === null) return null;
    if (day) return buildIClassProUrl(rec.levelId, day);
    return `${ICLASSPRO_CLASSES_URL}?levels=${rec.levelId}`;
  }

  function getSessionTimesForDay(rec: Recommendation, day: DayName | null): string[] {
    if (!day) return [];

    return Array.from(
      new Set(
        rec.sessions
          .filter((session) => session.day === day)
          .map(formatClassSessionTime),
      ),
    );
  }

  function renderSessionPreview(rec: Recommendation, selectedDay: DayName | null) {
    if (!selectedDay) {
      return `<p class="cs-day-picker-hint">Select a day to preview class times. Final availability is confirmed in iClassPro.</p>`;
    }

    const sessionTimes = getSessionTimesForDay(rec, selectedDay);
    const dayName = formatDayName(selectedDay);

    if (sessionTimes.length === 0) {
      return `<p class="cs-day-picker-hint">Times for ${dayName} are confirmed in iClassPro.</p>`;
    }

    return `
      <div class="cs-session-preview" data-testid="class-session-preview">
        <div class="cs-session-preview-head">
          <p class="cs-session-preview-label">Available times</p>
          <p class="cs-time-card-day">${dayName}</p>
        </div>
        <div class="cs-session-list" aria-label="${dayName} class times">
          ${sessionTimes.map((time) => `<span class="cs-session-time">${time}</span>`).join('')}
        </div>
        <p class="cs-time-card-time">${sessionTimes.join(', ')}</p>
        <p class="cs-session-note">Times are a guide from the current class list. iClassPro shows live availability and waitlists.</p>
      </div>`;
  }

  function renderResult(rec: Recommendation, selectedDay: DayName | null, isFirstVisit = false) {
    if (rec.requiresContact) {
      bodyEl.innerHTML = `<section class="cs-outcome"><div class="cs-result-panel">
        <div class="cs-result-hero"><h2 class="cs-outcome-program">Let's check the right class</h2>
        <p class="cs-outcome-desc">We couldn't confirm a suitable session for the whole age group you selected. Contact our team to check your child's exact age and available classes.</p>
        ${rec.key === 'playgym' ? `<p>${escapeHtml(programNames.playgym)}: ages ${escapeHtml(playgym.age_range)}.</p>` : ''}</div>
        <div class="cs-outcome-actions"><a href="/contact" class="cs-btn-primary">Contact our team</a><button class="cs-restart" id="cs-restart" type="button">Start again</button></div>
      </div></section>`;
      document.getElementById('cs-restart')?.addEventListener('click', () => { history = []; currentStep = { name: 'age' }; renderCurrent(); });
      focusFirstInteractive();
      return;
    }
    const isPlayGym = rec.stream === 'PlayGym';
    const url = portalUrl(rec, selectedDay);
    const dayLabel = selectedDay ? formatDayName(selectedDay) : null;
    const heroClass = isFirstVisit ? 'cs-result-hero is-reveal' : 'cs-result-hero';
    const eyebrow = isFirstVisit ? 'We found it!' : 'Your class';

    const checkSvg = `<svg width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 5.5l3 3 5-5"/></svg>`;

    const availabilityHtml = isPlayGym
      ? `<div class="cs-result-detail">
           <p class="cs-result-detail-label">Availability</p>
           <p class="cs-result-detail-value">${rec.sessions.map(session => `${formatDayName(session.day)}: ${escapeHtml(formatClassSessionTime(session))}`).join('<br>')}</p>
         </div>`
      : `<div class="cs-result-detail cs-result-detail-days">
           <p class="cs-result-detail-label">Pick a day to get started</p>
           <div class="cs-day-pills">
             ${rec.availableDays.map((day) => {
               const sel = day === selectedDay;
               return `<button class="cs-day-pill${sel ? ' is-selected' : ''}" type="button" data-day="${day}">${sel ? checkSvg : ''}${formatDayName(day)}</button>`;
             }).join('')}
           </div>
           ${renderSessionPreview(rec, selectedDay)}
         </div>`;

    const ctaHtml = isPlayGym
      ? `<a href="${rec.programPage}" class="cs-btn-primary">View ${escapeHtml(rec.name)} details</a>`
      : selectedDay && url
      ? `<a href="${url}" class="cs-btn-primary" target="_blank" rel="noopener">View ${dayLabel} classes</a>`
      : `<a href="${url ?? rec.programPage}" class="cs-btn-secondary" target="_blank" rel="noopener">Browse all classes</a>`;

    // Keyed off the class, not the stream: Adventurers shares the EduGym stream
    // with Levels 1–5+, and this note only applies to the preschool class.
    const noteHtml = (rec.key === 'edu_adv')
      ? `<div class="cs-outcome-note">
           <p class="cs-outcome-note-title">Good to know</p>
           <p class="cs-outcome-note-copy">Children attend independently. Parents are welcome to watch from the viewing area.</p>
         </div>`
      : '';

    const crossLinkHtml = rec.key === 'edu_adv'
      ? `<div class="cs-crosslink">
           <p class="cs-crosslink-title">Want to visit us first?</p>
           <p class="cs-crosslink-copy">${escapeHtml(programNames.playgym)} is our casual drop-in session for ages ${escapeHtml(playgym.age_range)}. ${escapeHtml(playgymSupervision)}. No booking required.</p>
           <a href="/playgym" class="cs-crosslink-link">Learn about ${escapeHtml(programNames.playgym)} →</a>
         </div>`
      : rec.stream === 'PlayGym'
      ? `<div class="cs-crosslink">
           <p class="cs-crosslink-title">What comes next?</p>
           <p class="cs-crosslink-copy">Our coached classes start at 3 years 6 months. When they get there, ${escapeHtml(levelName('edu_adv'))} is the natural next step — an independent weekly class with parents watching from the viewing area.</p>
           <a href="/preschool" class="cs-crosslink-link">Learn about preschool classes →</a>
         </div>`
      : '';

    bodyEl.innerHTML = `
      <section class="cs-outcome">
        <div class="cs-result-panel">
          <div class="${heroClass}">
            <div class="cs-result-topline">
              <p class="cs-result-eyebrow">${eyebrow}</p>
              <span class="cs-program-chip">${escapeHtml(rec.streamLabel)}</span>
            </div>

            ${isFirstVisit ? '<p class="cs-match-label">Your class is</p>' : ''}
            <h2 class="cs-outcome-program">${escapeHtml(rec.name)}</h2>
            <p class="cs-outcome-desc">${escapeHtml(rec.summary)}</p>
          </div>

          <div class="cs-result-grid">
            ${availabilityHtml}
          </div>

          ${noteHtml}

          <div class="cs-outcome-actions">
            ${ctaHtml}
            ${isPlayGym ? '' : `<a href="${rec.programPage}" class="cs-btn-secondary">Learn more about ${escapeHtml(rec.streamLabel)}</a>`}
            <button class="cs-restart" type="button" id="cs-restart">Start again</button>
          </div>

          ${crossLinkHtml}
        </div>
      </section>`;

    if (!isPlayGym) {
      bodyEl.querySelectorAll<HTMLButtonElement>('.cs-day-pill').forEach((pill) => {
        pill.addEventListener('click', () => {
          const day = pill.dataset.day as DayName;
          if (currentStep.name === 'result') {
            currentStep = { ...currentStep, selectedDay: day };
          }
          renderResult(rec, day);
        });
      });
    }

    document.getElementById('cs-restart')?.addEventListener('click', () => {
      history = [];
      currentStep = { name: 'age' };
      renderCurrent();
    });

    focusFirstInteractive();

    if (isFirstVisit) {
      setTimeout(firePartyPopper, 350);
      // After confetti settles, nudge the CTA button to pull the eye downward
      setTimeout(() => {
        bodyEl.querySelector<HTMLElement>('.cs-btn-primary, .cs-btn-secondary')?.classList.add('is-nudge');
      }, 1950);
    }
  }

  // ─── Event listeners ──────────────────────────────────────────────────────────

  closeBtn.addEventListener('click', closeSelector);
  backdrop.addEventListener('click', closeSelector);
  backBtn.addEventListener('click', goBack);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) closeSelector();
  });

  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-open-class-selector]')) {
      e.preventDefault();
      openSelector();
    }
  });
</script>
