---
import clubDetails from '../content/club-details.json';
import { siteConfig } from '../config/site';

// Phone label and dial links both come from the shared club details.
const telHref = `+${siteConfig.phone}`;
const phoneDisplay = clubDetails.phone;

const mailHref = `mailto:${siteConfig.email}?subject=${encodeURIComponent('Question about Trident Gymnastics')}`;
---

<!-- Floating contact button. Email is the action we want families to take, so
     it gets the one filled pill; call and text sit under it as small chips for
     people who would rather not write. The button toggles a menu because a
     single link could only offer one of the three. -->
<div class="fab" data-contact-fab>
  <ul class="fab__menu" id="floating-contact-menu">
    <li>
      <a class="fab__action fab__action--primary" href={mailHref}>
        <span class="fab__action-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
        </span>
        <span class="fab__action-text">
          <strong>Email us</strong>
          <span>{siteConfig.email}</span>
        </span>
      </a>
    </li>
    <li class="fab__minor">
      <a class="fab__action fab__action--minor" href={`tel:${telHref}`} aria-label={`Call us on ${phoneDisplay}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
        <span>Call</span>
      </a>
      <a class="fab__action fab__action--minor" href={`sms:${telHref}`} aria-label={`Text us on ${phoneDisplay}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.8-.8L3 21l1.9-5.1A8.4 8.4 0 0 1 4 11.5 8.5 8.5 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"/></svg>
        <span>Text</span>
      </a>
    </li>
  </ul>

  <button
    type="button"
    class="fab__toggle"
    aria-expanded="false"
    aria-controls="floating-contact-menu"
    data-fab-toggle
  >
    <svg class="fab__icon fab__icon--open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
    <svg class="fab__icon fab__icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    <span class="fab__sr" data-fab-label>Contact us</span>
  </button>
</div>

<style>
  .fab {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    /* The closed menu still takes up layout space, so this column is a ~287x178
       invisible box pinned over the bottom right of every page at z-index 9999.
       Without this it swallowed taps meant for whatever sat underneath — most
       visibly the Contact link in the open mobile menu on a short phone. Only
       the toggle, and the menu once it is open, should be hit targets. */
    pointer-events: none;
  }

  .fab__toggle,
  .fab[data-open] .fab__menu {
    pointer-events: auto;
  }

  /* Closed state is visibility:hidden, which also takes the links out of the
     tab order — no inert/hidden juggling needed to keep it keyboard-correct. */
  .fab__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.96);
    transform-origin: bottom right;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
  }

  .fab[data-open] .fab__menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* Call and text share a line under the email pill. */
  .fab__minor {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .fab__action {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px 10px 12px;
    background: var(--white, #fff);
    border: 1px solid var(--border-subtle, rgba(21, 25, 87, 0.1));
    border-radius: 999px;
    box-shadow: 0 8px 22px rgba(21, 25, 87, 0.16);
    text-decoration: none;
    color: var(--dark-navy, #151957);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .fab__action--primary {
    padding: 12px 20px 12px 12px;
    background: var(--primary-blue, #1573c2);
    /* The FAB floats over whatever is behind it, including the blue hero, so
       the pill carries its own white edge rather than relying on contrast. */
    border-color: rgba(255, 255, 255, 0.92);
    color: #fff;
    box-shadow: 0 10px 26px rgba(21, 115, 194, 0.38);
  }

  /* Minor actions: no filled background, smaller type, label only — the number
     lives in the aria-label so the chips stay narrow enough to sit side by side. */
  .fab__action--minor {
    gap: 7px;
    padding: 8px 14px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted, #6c757d);
    box-shadow: 0 4px 14px rgba(21, 25, 87, 0.12);
  }

  .fab__action--minor svg {
    width: 16px;
    height: 16px;
    color: var(--primary-blue, #1573c2);
  }

  .fab__action--minor:hover,
  .fab__action--minor:focus-visible {
    color: var(--dark-navy, #151957);
  }

  .fab__action:hover,
  .fab__action:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(21, 25, 87, 0.22);
  }

  .fab__action--primary:hover,
  .fab__action--primary:focus-visible {
    box-shadow: 0 14px 30px rgba(21, 115, 194, 0.5);
  }

  .fab__action:focus-visible {
    outline: 3px solid var(--primary-blue, #1573c2);
    outline-offset: 3px;
  }

  .fab__action--primary:focus-visible {
    outline-color: var(--dark-navy, #151957);
  }

  .fab__action-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--light-bg, #f8fbff);
    color: var(--primary-blue, #1573c2);
  }

  .fab__action-icon svg {
    width: 19px;
    height: 19px;
  }

  .fab__action--primary .fab__action-icon {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  .fab__action-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .fab__action-text strong {
    font-size: 1rem;
    font-weight: 700;
  }

  .fab__action-text span {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .fab__toggle {
    width: 60px;
    height: 60px;
    border: none;
    border-radius: 50%;
    background: var(--primary-blue, #1573c2);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(21, 115, 194, 0.45), 0 2px 4px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.2s ease;
    animation: fab-pulse 2s infinite;
  }

  .fab__toggle:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 20px rgba(21, 115, 194, 0.55), 0 3px 6px rgba(0, 0, 0, 0.25);
    animation: none;
  }

  .fab__toggle:focus-visible {
    outline: 3px solid var(--primary-blue, #1573c2);
    outline-offset: 4px;
    animation: none;
  }

  .fab__toggle:active {
    transform: scale(1.03);
  }

  /* Open: settle into the navy so the button reads as "close", not another CTA. */
  .fab[data-open] .fab__toggle {
    background: var(--dark-navy, #151957);
    animation: none;
  }

  .fab__icon {
    grid-area: 1 / 1;
    width: 30px;
    height: 30px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .fab__icon--close,
  .fab[data-open] .fab__icon--open {
    opacity: 0;
    transform: rotate(-45deg) scale(0.7);
  }

  .fab__icon--open,
  .fab[data-open] .fab__icon--close {
    opacity: 1;
    transform: none;
  }

  .fab__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes fab-pulse {
    0%, 100% {
      box-shadow: 0 4px 12px rgba(21, 115, 194, 0.45), 0 2px 4px rgba(0, 0, 0, 0.2);
    }
    50% {
      box-shadow: 0 4px 12px rgba(21, 115, 194, 0.6), 0 2px 4px rgba(0, 0, 0, 0.2), 0 0 0 8px rgba(21, 115, 194, 0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab__toggle,
    .fab__toggle:hover {
      animation: none;
      transform: none;
    }

    .fab__menu,
    .fab__action,
    .fab__icon {
      transition: opacity 0.01ms, visibility 0.01ms;
      transform: none;
    }

    .fab__action:hover,
    .fab__action:focus-visible {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .fab {
      bottom: 16px;
      right: 16px;
    }

    .fab__toggle {
      width: 56px;
      height: 56px;
    }

    .fab__icon {
      width: 27px;
      height: 27px;
    }

    /* Keep the widest pill (the email address) inside a 320px viewport. */
    .fab__action--primary {
      max-width: calc(100vw - 44px);
    }

    .fab__action-text span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  @media (max-width: 640px) {
    .fab {
      bottom: 20px;
      right: 12px;
    }
  }
</style>

<script>
  const fab = document.querySelector<HTMLElement>('[data-contact-fab]');
  const toggle = fab?.querySelector<HTMLButtonElement>('[data-fab-toggle]');
  const label = fab?.querySelector<HTMLElement>('[data-fab-label]');

  if (fab && toggle && label) {
    const setOpen = (open: boolean) => {
      fab.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      // The button's accessible name is its only text, so it has to say what
      // the next press will do.
      label.textContent = open ? 'Close contact options' : 'Contact us';
    };

    toggle.addEventListener('click', () => {
      setOpen(!fab.hasAttribute('data-open'));
    });

    // Escape closes and hands focus back to the button.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && fab.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // A tap anywhere else closes it. mailto:/tel:/sms: keep the page open, so
    // the menu also closes once an option is chosen.
    document.addEventListener('click', (e) => {
      if (!fab.hasAttribute('data-open')) return;
      const target = e.target as Node;
      if (!fab.contains(target) || (target as Element).closest?.('.fab__action')) {
        setOpen(false);
      }
    });
  }
</script>
