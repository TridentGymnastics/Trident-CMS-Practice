---
import clubDetails from '../content/club-details.json';
import { siteConfig } from '../config/site';

const telHref = `+${siteConfig.phone}`;
const phoneDisplay = clubDetails.phone;
---

<section class="operating-hours section" id="hours" aria-labelledby="hours-heading">
  <div class="container">
    <div class="hours-grid">
      <!-- Operating Hours -->
      <div class="hours-card card">
        <h2 id="hours-heading">Operating Hours</h2>
        <div class="hours-list">
          <p style="white-space:pre-line;line-height:2">{clubDetails.opening_hours}</p>
        </div>
      </div>

      <!-- Contact Information -->
      <div class="contact-card card">
        <h2>Contact Us</h2>
        <div class="contact-list">
          <div class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <div>
              <div class="contact-label">Phone</div>
              <a href={`tel:${telHref}`} class="contact-value">{phoneDisplay}</a>
            </div>
          </div>

          <div class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <div>
              <div class="contact-label">Email</div>
              <a href={`mailto:${siteConfig.email}`} class="contact-value contact-value--email">{siteConfig.email}</a>
            </div>
          </div>

          <div class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <div class="contact-label">Address</div>
              <a
                href={siteConfig.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-value"
                aria-label={`Open ${siteConfig.address} in Google Maps (opens in a new tab)`}
              >
                {siteConfig.address}
                <svg class="contact-external" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </a>
            </div>
          </div>

          <div class="social-links">
            <a
              href={siteConfig.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="social-btn"
              aria-label="Visit our Facebook page"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a
              href={siteConfig.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="social-btn"
              aria-label="Visit our Instagram page"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .operating-hours {
    background: white;
    padding: 4rem 0;
  }

  .hours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .hours-card,
  .contact-card {
    padding: 2.5rem 2rem;
    /* A grid item's default minimum is its min-content width, so one long
       unbreakable token (the email address) pushed the shared track wider than
       the container and clipped both cards off the right of a phone screen. */
    min-width: 0;
  }

  .hours-card h2,
  .contact-card h2 {
    font-size: 1.8rem;
    color: var(--dark-navy);
    margin-bottom: 2rem;
    text-align: center;
  }

  .hours-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hours-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 10px;
    background: var(--light-bg);
    transition: all 0.3s ease;
  }

  .hours-row:hover {
    background: rgba(21, 115, 194, 0.08);
    transform: translateX(5px);
  }

  .hours-row.closed {
    opacity: 0.6;
  }

  .day-name {
    font-weight: 700;
    color: var(--dark-navy);
    font-size: 1rem;
  }

  .day-hours {
    color: var(--text-muted);
    font-size: 0.95rem;
    text-align: right;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 0.35rem;
  }

  /* Keeps a time range intact — it must never break across lines. */
  .day-session {
    white-space: nowrap;
  }

  /* On wide rows the sessions read as one comma-separated line, as before. */
  .day-session:not(:last-child)::after {
    content: ",";
  }

  .hours-row.closed .day-hours {
    color: var(--text-muted);
    font-style: italic;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem;
    border-radius: 10px;
    background: var(--light-bg);
    transition: all 0.3s ease;
    min-width: 0;
  }

  /* The label/value stack is the flex child that has to be allowed to shrink. */
  .contact-item > div {
    min-width: 0;
  }

  .contact-item:hover {
    background: rgba(21, 115, 194, 0.08);
    transform: translateX(5px);
  }

  .contact-icon {
    width: 24px;
    height: 24px;
    color: var(--primary-blue);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .contact-value {
    color: var(--dark-navy);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s ease;
    display: block;
    /* `anywhere` rather than `break-word`: only `anywhere` lowers the element's
       min-content width, which is what stops the email widening the grid. */
    overflow-wrap: anywhere;
  }

  /* These three are all real links (dial, compose, open in Maps), so they have
     to look like it — plain bold navy read as static text. */
  .contact-value {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(21, 115, 194, 0.4);
  }

  .contact-value:hover,
  .contact-value:focus-visible {
    color: var(--primary-blue);
    text-decoration-thickness: 2px;
    text-decoration-color: currentColor;
  }

  .contact-value:focus-visible {
    outline: 3px solid var(--primary-blue);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Outbound cue for the only link that leaves the site. */
  .contact-external {
    width: 0.85em;
    height: 0.85em;
    margin-left: 0.25rem;
    vertical-align: -0.08em;
    color: var(--primary-blue);
    display: inline-block;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .social-btn {
    width: 50px;
    height: 50px;
    background: var(--primary-blue);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: all 0.3s ease;
    box-shadow: 0 4px 10px rgba(21, 115, 194, 0.3);
  }

  .social-btn svg {
    width: 24px;
    height: 24px;
  }

  .social-btn:hover {
    background: var(--dark-navy);
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(21, 25, 87, 0.4);
  }

  @media (max-width: 768px) {
    .operating-hours {
      padding: 3rem 0;
    }

    /* Layout already wraps the page in .container, so this section's own
       container doubles the inset to 40px a side — enough to squeeze the
       email and the day/hours rows on a phone. Drop the inner one. */
    .operating-hours .container {
      padding-inline: 0;
    }

    .hours-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .hours-card,
    .contact-card {
      padding: 2rem 1.5rem;
    }

    .hours-card h2,
    .contact-card h2 {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .day-hours {
      font-size: 0.85rem;
      flex-direction: column;
      align-items: flex-end;
      flex-wrap: nowrap;
      gap: 0.15rem;
    }

    /* Stacked, so the comma separator would dangle at the end of a line. */
    .day-session:not(:last-child)::after {
      content: none;
    }

    /* Align the day name with the first session rather than centring it
       against a two-line block. */
    .hours-row {
      align-items: flex-start;
    }

    .contact-value {
      font-size: 0.95rem;
    }

    /* Sized to keep the address on one line rather than breaking mid-domain. */
    .contact-value--email {
      font-size: 0.85rem;
    }
  }

  /* On the narrowest phones the day name and its times cannot share a line,
     so stack them instead of letting them collide. */
  @media (max-width: 380px) {
    .hours-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }

    .day-hours {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
