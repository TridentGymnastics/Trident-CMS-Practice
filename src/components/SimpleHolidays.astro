---
import Layout from '../layouts/Layout.astro';
import holiday from '../content/holidays.json';
import { playgym, playgymSupervision } from '../data/programContent';
interface Props { program?: string }
const { program } = Astro.props;
const open = holiday.status === 'open';
const cards = [
  ...(holiday.playgym_enabled ? [{ id: 'playgym', title: playgym.title, ages: playgym.age_range, description: `${playgym.tagline} ${playgymSupervision}.`, sessions: holiday.playgym_times, price: playgym.prices.items[0].price, dropIn: true }] : []),
  ...holiday.programs.filter(item => item.enabled).map(item => ({ ...item, dropIn: false })),
];
const shown = program ? cards.filter(item => item.id === program) : cards;
---
<Layout title="School Holiday Programs" description="School holiday gymnastics at Trident Gymnastics in Ringwood. Program information and booking links.">
  <section class="holiday-heading">
    <p class="eyebrow">Trident Gymnastics · Ringwood</p>
    <h1>School holiday programs</h1>
    {open ? <p class="dates">{holiday.dates}</p> : <p class="dates">{holiday.status === 'coming_soon' ? 'Next program coming soon' : 'Our holiday program has finished'}</p>}
    <p>{open ? 'Choose a program below. Available places and booked session times are shown in our booking portal.' : 'We will share the next holiday program here when it is ready. Contact the team with any questions.'}</p>
    {!open && <a class="btn btn-accent" href="/contact">Contact us</a>}
  </section>
  {open && <section class="holiday-content">
    {holiday.notice && <p class="holiday-notice">{holiday.notice}</p>}
    {program && <p><a href="/school-holidays">← All holiday programs</a></p>}
    {shown.length ? <div class="holiday-cards">{shown.map(item => <article class="holiday-card" id={item.id}>
      <h2>{item.title}</h2><p class="ages">Ages {item.ages}</p>
      <p>{item.description}</p><p class="sessions">{item.sessions}</p>
      <p class="price">{item.price}</p>
      {item.dropIn ? <p class="drop-in">No booking required — pay at the door.</p> : <a class="btn btn-primary" href={holiday.booking_url} target="_blank" rel="noopener">View times and book</a>}
    </article>)}</div> : <p>This program is not currently listed. <a href="/school-holidays">View the available holiday programs</a> or <a href="/contact">contact us</a>.</p>}
  </section>}
</Layout>
<style>
  .holiday-heading{padding:3rem 1.5rem;text-align:center;background:linear-gradient(120deg,#1573c2,#151957);color:#fff;border-radius:0 0 1.5rem 1.5rem}
  .holiday-heading h1{color:#fff;font-size:clamp(2rem,5vw,3.5rem);margin:.5rem 0 1rem}.holiday-heading p{color:#fff;max-width:65ch;margin:1rem auto}.eyebrow{font-weight:700}.dates{font-size:1.3rem;font-weight:700}
  .holiday-content{padding:2rem 1rem 3rem}.holiday-notice{padding:1rem 1.25rem;background:#fff3c6;border-radius:.75rem;white-space:pre-line}.holiday-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1.5rem;margin-top:1.5rem}.holiday-card{padding:1.75rem;border:1px solid #d7e4ef;border-radius:1rem;box-shadow:0 5px 20px #1519570d;display:flex;flex-direction:column;align-items:flex-start}.holiday-card h2{color:#151957;font-size:1.65rem;overflow-wrap:anywhere}.holiday-card p{line-height:1.7}.ages{color:#1573c2;font-weight:700}.sessions{white-space:pre-line}.price{font-size:1.25rem;font-weight:700}.drop-in{font-weight:700}.holiday-card .btn{margin-top:auto;text-align:center}
</style>
