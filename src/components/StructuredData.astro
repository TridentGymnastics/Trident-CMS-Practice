---
import { programNames as names, playgym } from '../data/programContent';
import { siteConfig } from '../config/site';

const phoneNumber = siteConfig.phone.replace(/\D/g, '');
const formattedPhone = `+${phoneNumber}`;
const businessId = `${siteConfig.siteUrl}/#business`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  '@id': businessId,
  name: siteConfig.siteName,
  url: siteConfig.siteUrl,
  image: siteConfig.defaultImage,
  logo: siteConfig.defaultImage,
  telephone: formattedPhone,
  email: siteConfig.email,
  priceRange: '$$',
  description: siteConfig.siteDescription,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.streetAddress,
    addressLocality: siteConfig.addressLocality,
    addressRegion: siteConfig.addressRegion,
    postalCode: siteConfig.postalCode,
    addressCountry: siteConfig.addressCountry
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteConfig.geo.latitude,
    longitude: siteConfig.geo.longitude
  },
  sameAs: [
    siteConfig.facebook,
    siteConfig.instagram
  ],
  areaServed: siteConfig.nearbyAreas.map((area) => ({
    '@type': 'City',
    name: area
  })),
  knowsAbout: [
    'Gymnastics classes',
    'Kids gymnastics',
    `${names.playgym}`,
    `${names.urbangym}`,
    'Birthday parties',
    'School holiday programs'
  ],
  makesOffer: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Gymnastics classes in Ringwood'
      }
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: `${names.playgym} for children aged ${playgym.age_range}`
      }
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Gymnastics birthday parties'
      }
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
