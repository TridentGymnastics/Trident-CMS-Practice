---
import { programNames as names } from '../data/programContent';
import WinterSnowField from './WinterSnowField.astro';
---

<section class="winter-promo" aria-labelledby="winter-holiday-title">
  <div class="winter-promo__frame">
    <WinterSnowField />

    <div class="winter-promo__content">
      <h2 id="winter-holiday-title" class="winter-promo__title">
        <span class="winter-promo__script">Winter</span>
        <span class="winter-promo__title-line">Holiday Program</span>
      </h2>

      <div class="winter-promo__chips">
        <p class="winter-promo__chip winter-promo__chip--date">29 June - 10 July</p>
        <a
          class="winter-promo__chip winter-promo__chip--status winter-promo__chip-link"
          href="/school-holidays"
        >
          Sessions Listed
        </a>
      </div>

      <p class="winter-promo__summary">{names.playgym}, OpenGym and Skill Workshops</p>

      <a class="btn winter-promo__cta" href="/school-holidays">View Schedule</a>
    </div>
  </div>
</section>

<style>
  .winter-promo {
    padding: 1.5rem 0 2rem;
  }

  .winter-promo__frame {
    position: relative;
    overflow: hidden;
    padding: clamp(2.75rem, 5vw, 4.5rem) clamp(1.25rem, 4vw, 3rem) clamp(3.75rem, 6.5vw, 4.75rem);
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    background:
      radial-gradient(circle at 50% 12%, rgba(147, 210, 255, 0.18), transparent 28%),
      radial-gradient(circle at 14% 82%, rgba(96, 165, 250, 0.12), transparent 26%),
      radial-gradient(circle at 88% 24%, rgba(186, 230, 253, 0.12), transparent 22%),
      linear-gradient(135deg, #07184d 0%, #0d2764 48%, #081844 100%);
    box-shadow: 0 24px 60px rgba(8, 18, 58, 0.28);
    isolation: isolate;
  }

  .winter-promo__frame::before,
  .winter-promo__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .winter-promo__frame::before {
    background:
      radial-gradient(circle at 8%  28%, rgba(255, 255, 255, 0.28) 0 1px, transparent 1.5px),
      radial-gradient(circle at 18% 72%, rgba(186, 230, 253, 0.32) 0 1px, transparent 1.5px),
      radial-gradient(circle at 28% 18%, rgba(255, 255, 255, 0.18) 0 1px, transparent 1.5px),
      radial-gradient(circle at 74% 20%, rgba(186, 230, 253, 0.28) 0 1px, transparent 1.5px),
      radial-gradient(circle at 84% 66%, rgba(255, 255, 255, 0.20) 0 1px, transparent 1.5px),
      radial-gradient(circle at 92% 34%, rgba(147, 210, 255, 0.22) 0 1px, transparent 1.5px);
    opacity: 0.85;
  }

  .winter-promo__frame::after {
    background:
      radial-gradient(circle at 50% 44%, rgba(96, 165, 250, 0.16), transparent 24%),
      radial-gradient(circle at 50% 46%, rgba(255, 255, 255, 0.08), transparent 18%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 18%),
      linear-gradient(0deg, rgba(147, 210, 255, 0.14), transparent 24%);
    mix-blend-mode: screen;
  }

  .winter-promo__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    gap: 1rem;
  }

  .winter-promo__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    line-height: 0.92;
  }

  .winter-promo__script {
    font-family: "Brush Script MT", "Segoe Script", "Snell Roundhand", "Apple Chancery", "URW Chancery L", cursive;
    font-size: clamp(3.15rem, 9vw, 6.2rem);
    font-weight: 700;
    color: #d1f0ff;
    letter-spacing: 0.01em;
    text-shadow:
      0 4px 0 rgba(0, 60, 120, 0.34),
      0 10px 22px rgba(12, 19, 54, 0.32);
  }

  .winter-promo__title-line {
    margin-top: 0.35rem;
    font-size: clamp(1.45rem, 3.6vw, 2.85rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #ffffff;
    text-shadow: 0 8px 22px rgba(12, 19, 54, 0.24);
  }

  .winter-promo__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
  }

  .winter-promo__chip {
    margin: 0;
    border-radius: 999px;
    font-weight: 800;
    letter-spacing: 0.01em;
    box-shadow: 0 10px 24px rgba(10, 18, 54, 0.18);
  }

  .winter-promo__chip-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  }

  .winter-promo__chip-link:hover {
    transform: translateY(-2px);
    filter: saturate(1.03);
    box-shadow: 0 14px 28px rgba(10, 18, 54, 0.24);
  }

  .winter-promo__chip-link:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.9);
    outline-offset: 3px;
  }

  .winter-promo__chip--date {
    padding: 0.75rem 1.25rem;
    color: #bfe3ff;
    background: linear-gradient(180deg, rgba(24, 57, 127, 0.92), rgba(13, 34, 90, 0.92));
    border: 1px solid rgba(147, 210, 255, 0.38);
    font-size: clamp(1rem, 2vw, 1.45rem);
  }

  .winter-promo__chip--status {
    padding: 0.85rem 1.35rem;
    color: #0d215c;
    background: linear-gradient(180deg, #d0eeff 0%, #93c5fd 100%);
    font-size: clamp(1rem, 1.8vw, 1.3rem);
  }

  .winter-promo__summary {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.7rem);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 8px 20px rgba(8, 18, 58, 0.24);
  }

  .winter-promo__cta {
    margin-top: 0.35rem;
    padding-inline: 2rem;
    background: linear-gradient(180deg, #ffe792 0%, #ffd338 52%, #efb90e 100%);
    color: #0f225c;
    font-weight: 800;
    box-shadow:
      0 14px 28px rgba(255, 174, 17, 0.24),
      0 5px 16px rgba(9, 20, 61, 0.18);
  }

  .winter-promo__cta:hover {
    background: linear-gradient(180deg, #fff1b2 0%, #ffd338 52%, #e8b100 100%);
    color: #0b1c4d;
  }

  @media (max-width: 900px) {
    .winter-promo {
      padding-top: 1.25rem;
    }

    .winter-promo__frame {
      border-radius: 24px;
      padding-inline: 1rem;
    }

    .winter-promo__summary {
      max-width: 26rem;
    }
  }

  @media (max-width: 640px) {
    .winter-promo {
      padding-top: 1rem;
      padding-bottom: 1.5rem;
    }

    .winter-promo__frame {
      padding: 2.5rem 1rem 3.5rem;
      border-radius: 22px;
    }

    .winter-promo__chips {
      gap: 0.7rem;
    }

    .winter-promo__chip--date,
    .winter-promo__chip--status {
      width: 100%;
      max-width: 17rem;
      text-align: center;
    }

    .winter-promo__summary {
      max-width: 18rem;
      font-size: 1rem;
    }
  }
</style>
