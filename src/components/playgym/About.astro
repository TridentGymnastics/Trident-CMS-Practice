---
const { data } = Astro.props;
---

<section class="about-section">
  <div class="container">
    <h2>What is {data.title}?</h2>
    <div class="about-content">
      {data.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 4rem 0;
  }

  .about-section h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: var(--primary-color, #67a0d7);
  }

  .about-content {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .about-content p {
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
    color: var(--text-color, #333);
  }

  .about-content p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .about-section h2 {
      font-size: 2rem;
    }

    .about-content p {
      font-size: 1rem;
    }
  }

  @media (max-width: 640px) {
    .about-section {
      padding: 2.5rem 0;
    }

    .about-section h2 {
      font-size: 1.6rem;
      margin-bottom: 1.5rem;
    }

    .about-content p {
      font-size: 0.96rem;
      margin-bottom: 1rem;
      line-height: 1.7;
    }
  }
</style>