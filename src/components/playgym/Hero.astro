---
const { data } = Astro.props;
---

<section class="page-header">
  <div class="container">
    <h1>{data.title}</h1>
    <div class="hero-age-strip">
      <span class="hero-age-badge">Ages {data.age_range}</span>
      {data.adult_helper_required && (
        <span class="hero-age-note">Parent-supervised play</span>
      )}
    </div>
    <p class="tagline">{data.tagline}</p>
    <div class="cta-buttons">
      <span class="primary-cta">{data.cta.primary}</span>
      <a href="/contact" class="btn btn-secondary">{data.cta.secondary}</a>
    </div>
  </div>
</section>

<style>
  .page-header {
    background: linear-gradient(135deg, #67a0d7 0%, #151957 100%);
    color: white;
    min-height: 50vh;
    display: flex;
    align-items: center;
    text-align: center;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
    color: white;
  }

  .hero-age-strip {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .hero-age-badge,
  .hero-age-note {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    font-weight: 700;
  }

  .hero-age-badge {
    background: var(--accent-yellow, #ffe037);
    color: var(--dark-navy, #151957);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  }

  .hero-age-note {
    background: rgba(255, 255, 255, 0.16);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.24);
    backdrop-filter: blur(10px);
  }

  .tagline {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    opacity: 0.95;
    color: white;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .primary-cta {
    font-size: 1.125rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.2);
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    backdrop-filter: blur(10px);
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .page-header {
      padding-top: 2rem;
    }

    .page-header h1 {
      font-size: 2rem;
    }

    .hero-age-strip {
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .hero-age-badge,
    .hero-age-note {
      width: 100%;
    }

    .cta-buttons {
      flex-direction: column;
      padding-bottom: 2rem;
    }

    .primary-cta,
    .btn {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding-top: 1.1rem;
      padding-bottom: 1.1rem;
    }
  }

  @media (max-width: 640px) {
    .page-header {
      min-height: auto;
      padding: 1.75rem 0 2rem;
    }

    .page-header h1 {
      font-size: 1.8rem;
      margin-bottom: 0.6rem;
    }

    .tagline {
      font-size: 1rem;
      margin-bottom: 1.25rem;
    }

    .primary-cta,
    .btn {
      padding-top: 0.85rem;
      padding-bottom: 0.85rem;
      font-size: 0.95rem;
    }
  }
</style>
