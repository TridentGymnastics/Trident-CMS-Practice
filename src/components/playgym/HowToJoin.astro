---
const { data } = Astro.props;
---

<section class="how-to-join-section">
  <div class="container">
    <h2>How to Join</h2>
    <div class="join-content">
      <div class="main-info">
        <p class="join-text">{data.how_to_join.text}</p>
        <p class="join-note">{data.how_to_join.note}</p>
        <a class="holiday-join-link" href={data.schedule.holiday_link_href}>
          Holiday {data.title} for ages {data.age_range}: view current holiday dates
        </a>
      </div>

      <div class="join-steps">
        <div class="step">
          <div class="step-content">
            <h3>Just Show Up</h3>
            <p>Come along during our scheduled {data.title} times</p>
          </div>
        </div>

        <div class="step">
          <div class="step-content">
            <h3>Pay at the Door</h3>
            <p>Card or cash accepted, or use your punch pass</p>
          </div>
        </div>

        <div class="step">
          <div class="step-content">
            <h3>Play & Explore</h3>
            <p>Let your little ones explore and have fun!</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-to-join-section {
    padding: 4rem 0;
    background: var(--bg-light, #f8f9fa);
  }

  .how-to-join-section h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: var(--primary-color, #67a0d7);
  }

  .join-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .main-info {
    text-align: center;
    margin-bottom: 3rem;
  }

  .join-text {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--text-color, #333);
    line-height: 1.6;
  }

  .join-note {
    background: white;
    padding: 1rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 500;
    color: var(--accent-color, #151957);
    border-left: 4px solid var(--accent-color, #ffe037);
    margin: 0;
  }

  .holiday-join-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--tg-yellow-2, #ffeaa3), var(--tg-yellow, #ffe037));
    color: var(--dark-navy, #151957);
    text-decoration: none;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(11, 17, 80, 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .holiday-join-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(11, 17, 80, 0.22);
  }

  .holiday-join-link:focus {
    outline: 3px solid var(--accent-yellow, #ffe037);
    outline-offset: 3px;
  }

  .join-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .step {
    background: white;
    padding: 1.5rem;
    border-radius: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .step:hover {
    transform: translateY(-3px);
  }

  .step-content h3 {
    color: var(--primary-color, #67a0d7);
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
  }

  .step-content p {
    margin: 0;
    color: var(--text-muted, #666);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .how-to-join-section h2 {
      font-size: 2rem;
    }

    .join-steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .how-to-join-section {
      padding: 2.5rem 0;
    }

    .how-to-join-section h2 {
      font-size: 1.6rem;
      margin-bottom: 1.5rem;
    }

    .main-info {
      margin-bottom: 1.5rem;
    }

    .join-text {
      font-size: 1rem;
    }

    /* Stacked steps — full-width cards on phone */
    .join-steps {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .step {
      padding: 1.15rem 1rem;
      text-align: center;
    }

    .step-content h3 {
      font-size: 1.05rem;
      margin-bottom: 0.3rem;
    }

    .step-content p {
      font-size: 0.9rem;
      line-height: 1.45;
    }
  }
</style>
