---
const { data } = Astro.props;
---

<section class="policies-section">
  <div class="container">
    <h2>Policies & Information</h2>
    <div class="policies-grid">
      {data.policies.map((policy) => (
        <a href={policy.href} target="_blank" rel="noopener noreferrer" class="policy-link">
          <div class="policy-card">
            <div class="policy-icon">📄</div>
            <h3>{policy.title}</h3>
            <div class="external-icon">↗</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .policies-section {
    padding: 4rem 0;
  }

  .policies-section h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: var(--primary-color, #67a0d7);
  }

  .policies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .policy-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }

  .policy-card {
    background: white;
    padding: 2rem;
    border-radius: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--border-color, #e0e0e0);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    height: 100%;
  }

  .policy-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    border-color: var(--primary-color, #67a0d7);
  }

  .policy-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .policy-card h3 {
    color: var(--primary-color, #67a0d7);
    margin: 0;
    font-size: 1.125rem;
    flex-grow: 1;
    line-height: 1.4;
  }

  .external-icon {
    color: var(--text-muted, #666);
    font-size: 1.25rem;
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .policy-card:hover .external-icon {
    opacity: 1;
    color: var(--primary-color, #67a0d7);
  }

  @media (max-width: 768px) {
    .policies-section h2 {
      font-size: 2rem;
    }

    .policies-grid {
      grid-template-columns: 1fr;
    }

    .policy-card {
      padding: 1.5rem;
    }

    .policy-card h3 {
      font-size: 1rem;
    }
  }

  @media (max-width: 640px) {
    .policies-section {
      padding: 2.5rem 0;
    }

    .policies-section h2 {
      font-size: 1.6rem;
      margin-bottom: 1.5rem;
    }

    .policies-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .policy-card {
      padding: 1.1rem 1rem;
      gap: 0.75rem;
    }

    .policy-icon {
      font-size: 1.25rem;
    }

    .policy-card h3 {
      font-size: 0.95rem;
      line-height: 1.35;
    }

    .external-icon {
      font-size: 1rem;
    }
  }
</style>