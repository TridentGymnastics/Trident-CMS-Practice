---
const { data } = Astro.props;
---

<section class="prices-section" id="pricing">
  <div class="container">
    <h2>Pricing</h2>

    <div class="prices-content">
      <p class="prices-intro">{data.prices.intro}</p>

      <div class="price-cards">
        {data.prices.items.map((item) => (
          <div class="price-card">
            <h3>{item.label}</h3>
            <div class="price">{item.price}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .prices-section {
    padding: 4rem 0;
  }

  .prices-section h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--primary-blue);
  }

  .prices-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .prices-intro {
    text-align: center;
    font-size: 1.05rem;
    margin-bottom: 2rem;
    color: var(--text-body);
  }

  .price-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .price-card {
    background: white;
    padding: 2rem;
    border-radius: 1rem;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--border-subtle);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .price-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .price-card:nth-child(2) {
    border-color: var(--accent-yellow);
    border-width: 2px;
  }

  .price-card:nth-child(2)::before {
    content: "Popular";
    position: absolute;
    top: 1rem;
    right: -2rem;
    background: var(--accent-yellow);
    color: white;
    padding: 0.25rem 3rem;
    font-size: 0.875rem;
    font-weight: 600;
    transform: rotate(45deg);
  }

  .price-card h3 {
    color: var(--primary-blue);
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-yellow);
  }

  .price-savings {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-top: 0.55rem;
  }

  .savings-badge {
    display: inline-block;
    padding: 0.22rem 0.7rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #22c55e, #16a34a);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    box-shadow: 0 2px 8px rgba(34, 197, 94, 0.32);
  }

  .savings-detail {
    font-size: 0.75rem;
    color: var(--text-muted, #666);
    font-weight: 500;
  }

  .price-notes {
    text-align: center;
  }

  .multi-visit-note {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    background: transparent;
    padding: 0.9rem 1rem;
    border-left: 4px solid var(--primary-blue, #1573c2);
    border-radius: 0;
    margin-bottom: 2rem;
    font-weight: 600;
    color: var(--text-body);
    text-align: left;
  }

  .gift-blurb {
    background: white;
    border: 2px solid var(--accent-yellow);
    padding: 2rem;
    border-radius: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    text-align: center;
  }

  .gift-blurb h4 {
    margin-bottom: 1rem;
    font-size: 1.375rem;
    color: var(--accent-yellow);
  }


  .gift-blurb p {
    margin: 0;
    color: var(--text-body);
    line-height: 1.6;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .prices-section h2 {
      font-size: 2rem;
    }

    .price-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .prices-section {
      padding: 2.5rem 0;
    }

    .prices-section h2 {
      font-size: 1.6rem;
      margin-bottom: 1.5rem;
    }

    /* Stacked full-width cards on phone */
    .price-cards {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      margin-bottom: 2rem;
    }

    .price-card {
      padding: 1.35rem 1rem;
    }

    .price-card h3 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    .price {
      font-size: 1.35rem;
    }

    .gift-blurb {
      padding: 1.25rem;
    }

    .gift-blurb h4 {
      font-size: 1.15rem;
      margin-bottom: 0.65rem;
    }

    .gift-blurb p {
      font-size: 0.92rem;
    }

    .multi-visit-note {
      font-size: 0.88rem;
      padding: 0.65rem 0.85rem;
      margin-bottom: 1.25rem;
    }
  }

</style>
