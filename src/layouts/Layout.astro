---
import "../styles/tailwind.css";
import "../styles/theme.css";
import "../styles/program.css";
import "../styles/parties.css";
import { isPractice, isNonProduction } from '../../site-mode.mjs';
import Header from '../components/Header.astro';
import { programNames } from '../data/programContent';
import SiteNotice from '../components/SiteNotice.astro';
import FloatingContact from '../components/FloatingContact.astro';
import StructuredData from '../components/StructuredData.astro';
import { siteConfig } from '../config/site';
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import path from 'path';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title = "Trident Gymnastics", description = "" } = Astro.props;
const noindex = isNonProduction || Astro.props.noindex === true;
const pageDescription = description || siteConfig.siteDescription;
const fullTitle = title === 'Home'
  ? 'Kids Gymnastics Classes in Ringwood | Trident Gymnastics'
  : `${title} | ${siteConfig.siteName}`;
const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = `${siteConfig.siteUrl}${canonicalPath}`;

// Load assets from CMS
let assets = { primary_logo: null, footer_logo: null, hero_image: null };
try {
  const assetsPath = path.join(process.cwd(), 'content', 'assets.yml');
  const assetsFile = readFileSync(assetsPath, 'utf8');
  assets = parse(assetsFile);
} catch (error) {
  // Assets file doesn't exist or is empty, use defaults
}

// Determine logo URL
const primaryLogoUrl = assets.primary_logo ? `/uploads/${assets.primary_logo}` : '/Images/compressed-Logo.webp';
const footerLogoUrl = assets.footer_logo ? `/uploads/${assets.footer_logo}` : null;
const heroImageUrl = assets.hero_image ? `/uploads/${assets.hero_image}` : null;
const shareImageUrl = heroImageUrl ? `${siteConfig.siteUrl}${heroImageUrl}` : siteConfig.defaultImage;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {isNonProduction && <meta http-equiv="Content-Security-Policy" content="form-action 'none'" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#151957" />

    <!-- Self-hosted fonts - Preload all three weights to prevent font-swap CLS -->
    <link rel="preload" href="/fonts/montserrat/montserrat-v31-latin-regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/montserrat/montserrat-v31-latin-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/montserrat/montserrat-v31-latin-700.woff2" as="font" type="font/woff2" crossorigin>
    
    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    {/* noimageindex keeps our photos out of Google Images and reverse image
        search. Many of them show children in the facility, and image indexing
        makes them findable by people who never visit the site. Pages still rank
        normally — this only affects image indexing. */}
    <meta name="robots" content={isNonProduction ? 'noindex, nofollow, noarchive' : noindex ? 'noindex, follow' : 'index, follow, noimageindex'} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph and social preview tags -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImageUrl} />
    
    <!-- External service connections -->
    <link rel="dns-prefetch" href="https://wa.me" />

    <!-- Structured Data for SEO -->
    {!noindex && <StructuredData />}

    <!-- Page-specific head elements (preloads, etc.) -->
    <slot name="head" />
  </head>
  <body>
    {isNonProduction && <aside data-cms-practice-banner style="position:fixed;bottom:12px;left:12px;z-index:10000;max-width:calc(100vw - 24px);padding:10px 14px;border:2px solid #151957;border-radius:8px;background:#ffe281;color:#151957;font:700 12px/1.5 system-ui;box-shadow:0 2px 10px #0003;">{isPractice ? 'CMS PRACTICE ? NOT LIVE' : 'SITE PREVIEW ? NOT LIVE'}<br /><span style="font-weight:400">Test website. Forms disabled.</span></aside>}
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <Header />
    <SiteNotice />

    <main id="main-content" class="container" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-section">
            {footerLogoUrl ? (
              <img
                src={footerLogoUrl}
                alt="Trident Gymnastics"
                width="150"
                height="40"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <h2>{siteConfig.siteName}</h2>
            )}
            <div class="footer-tagline">
              <span class="empower">EMPOWER</span>
              <span class="with">with</span>
              <span class="movement">MOVEMENT</span>
            </div>
          </div>
          
          <div class="footer-section">
            <h3>Quick Links</h3>
            <ul>
              <li><a href="/classes">Classes</a></li>
              <li><a href="/playgym">{programNames.playgym}</a></li>
              <li><a href="/parties">Parties</a></li>
            </ul>
          </div>
          
          <div class="footer-section">
            <h3>Information</h3>
            <ul>
              <li><a href="/about">About Us</a></li>
              <li><a href="/contact">Contact &amp; Find Us</a></li>
              <li><a href="/school-holidays">School Holidays</a></li><!-- Live with the Spring program. TODO(summer): re-comment when it finishes. -->
              <li><a href="/policies">Policies</a></li>
              <li><a href="/app-guides">iClassPro App Guides</a></li>
            </ul>
          </div>
          
          <div class="footer-section">
            <h3>Contact</h3>
            <a 
              href={`https://wa.me/${siteConfig.phone}?text=${siteConfig.whatsappMessage}`}
              class="btn btn-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
              </svg>
              WhatsApp
            </a>
          </div>
        </div>
        
        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} {siteConfig.siteName}. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Floating contact button — email / call / text -->
    <FloatingContact />

    <!-- Global interactions (header scroll, nav dropdowns, mobile nav, etc.) -->
    <!-- Keep mobile-nav initialization centralized in global-init/mobile-nav.ts only. -->
    <script>
      import '../scripts/global-init';
    </script>
  </body>
</html>

<style>
  /* Footer specific styles */
  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
    padding: 3rem 0 1rem;
  }

  /* Tags are one level up from what they used to be so the document outline
     does not jump h1 -> h3; these pin the previous sizes. */
  .footer-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .footer-section h3 {
    font-size: 1rem;
    font-weight: 400;
  }

  .footer-section h2,
  .footer-section h3 {
    margin-bottom: 1rem;
  }

  .footer-section ul {
    list-style: none;
  }

  .footer-section ul li {
    margin-bottom: 0.5rem;
  }

  .footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    text-align: center;
    color: var(--text-muted);
  }

  .footer-tagline {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 0.5rem;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .footer-tagline .empower {
    color: #67a0d7; /* Primary blue */
    white-space: nowrap;
  }

  .footer-tagline .with {
    color: #ffe037; /* Accent yellow */
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .footer-tagline .movement {
    color: #151957; /* Secondary blue */
    white-space: nowrap;
  }

  /* WhatsApp button in footer */
  .footer-section .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .footer-section .btn svg {
    flex-shrink: 0;
  }

  /* Stack vertically on very small screens */
  @media (max-width: 480px) {
    .footer-tagline {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.1rem;
      line-height: 1.2;
    }
  }
</style>

<style is:global>
  /* Casual-save deterrents for photos/video of children in the facility.
     These stop drag-to-desktop and "Save image as"; they do NOT stop anyone
     determined — the files are public URLs and always will be. See the note in
     the script below. */
  img,
  video {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    user-select: none;
  }
</style>

<script>
  // Blocks drag-to-desktop and the right-click "Save image as" menu on media.
  //
  // This is a deterrent, not protection. Any image or video the browser renders
  // is already on the visitor's device and remains reachable at its direct URL —
  // DevTools, the Network tab or curl bypass all of this in seconds. It exists to
  // stop casual/accidental saving, nothing more. The controls that actually work
  // are noimageindex (set in the head) and being selective about which photos get
  // published at all.
  //
  // Scoped to img/video deliberately: blocking the context menu document-wide
  // would also break text selection, copy and open-in-new-tab for everything.
  function initMediaGuards() {
    document.querySelectorAll<HTMLElement>('img, video').forEach((el) => {
      el.setAttribute('draggable', 'false');
      el.addEventListener('dragstart', (e) => e.preventDefault());
      el.addEventListener('contextmenu', (e) => e.preventDefault());
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMediaGuards);
  } else {
    initMediaGuards();
  }
  document.addEventListener('astro:page-load', initMediaGuards);
</script>
