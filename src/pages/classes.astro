---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { readFileSync } from 'fs';
import path from 'path';

// Import optimized images
import preschoolImg from '../assets/images/homepage/preschool.webp';
import eduGymImg from '../assets/images/homepage/edugym.webp';
import urbanGymImg from '../assets/images/homepage/UrbanGym.webp';
import agcSquadImg from '../assets/images/homepage/agc-squad.webp';

// Load classes data
const classesPath = path.join(process.cwd(), 'content', 'classes', 'classes.json');
const classesData = JSON.parse(readFileSync(classesPath, 'utf8'));

// Map slug to optimized images
const imageMap: Record<string, any> = {
  'preschool': preschoolImg,
  'edugym': eduGymImg,
  'urbangym': urbanGymImg,
  'agc': agcSquadImg
};
---

<Layout title="Gymnastics Classes Ringwood" description="Discover Ringwood gymnastics classes at Trident Gymnastics, including preschool gymnastics, EduGym, UrbanGym and AGC competitive training.">
  {/* The Mon/Wed 10-11am morning slots carried over from the retired 2-4 program
      and now run as EduGym Adventurers classes, so this banner still holds. */}
  <a href="/preschool" class="announcement-banner announcement-banner--classes">
    <div class="confetti-wrapper">
      <span class="confetti">🎉</span>
      <span class="confetti">⭐</span>
      <span class="confetti">🌟</span>
    </div>
    <div class="announcement-content">
      <div class="announcement-badge">
        <span class="badge-star">★</span>
        <span class="badge-text">New Class Times</span>
      </div>
      <div class="announcement-info">
        <span class="announcement-title">EduGym Adventurers Morning Sessions</span>
        <div class="announcement-times">
          <span class="time-pill">Mon 10-11am</span>
          <span class="time-pill">Wed 10-11am</span>
        </div>
      </div>
      <span class="announcement-cta">
        Learn More
        <svg class="cta-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
    <div class="confetti-wrapper">
      <span class="confetti">🌟</span>
      <span class="confetti">⭐</span>
      <span class="confetti">🎉</span>
    </div>
  </a>

  <section class="hero">
    <div class="container">
      <h1>Gymnastics Classes in Ringwood</h1>
      <p class="hero-subtitle">From toddlers to competitive athletes, Trident offers structured Ringwood gymnastics programs designed to build strength, confidence, and skill at every level.</p>
      <div class="hero-cta-buttons">
        <a href="https://portal.iclasspro.com/trident" class="cta-trial cta-trial--lg" target="_blank" rel="noopener" aria-label="Book a free trial">
          <span class="cta-label">Book Free Trial</span>
          <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13 5l7 7-7 7M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="/contact" class="btn btn-secondary">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="classes-overview section section-band">
    <div class="container">
      <div class="class-grid">
        {classesData.map((program) => (
          <div class="card feature-card card-accent">
            <a href={`/${program.slug}`} class="card-image-link">
              <Picture
                src={imageMap[program.slug]}
                formats={['avif', 'webp', 'jpeg']}
                widths={[320, 480, 640, 960]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt={`${program.title} program`}
                width={960}
                height={640}
                loading="lazy"
                class="card-image"
              />
            </a>
            <div class="card-content">
              <h2>{program.title}</h2>
              <p>{program.blurb}</p>
              <a href={`/${program.slug}`} class="btn">Learn More</a>
            </div>
          </div>
        ))}
      </div>
      
      <div class="cta-section">
        <h2>Ready to Get Started?</h2>
        <p>Book a free trial class to find the perfect program for your child.</p>
        <a href="https://portal.iclasspro.com/trident" class="cta-trial" target="_blank" rel="noopener" aria-label="Book a free trial">
          <span class="cta-label">Book Free Trial</span>
          <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13 5l7 7-7 7M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Golden Celebratory Announcement Banner - Classes Page */
  .announcement-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    text-decoration: none;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .announcement-banner--classes {
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 30%, #f59e0b 60%, #fbbf24 100%);
    background-size: 200% 200%;
    animation: gradient-flow 4s ease infinite;
    border-bottom: 3px solid #d97706;
  }

  @keyframes gradient-flow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .announcement-banner:hover {
    transform: scale(1.01);
    box-shadow: 0 4px 25px rgba(245, 158, 11, 0.5);
  }

  .confetti-wrapper {
    display: flex;
    gap: 0.5rem;
  }

  .confetti {
    font-size: 1.2rem;
    animation: float 2s ease-in-out infinite;
  }

  .confetti:nth-child(1) { animation-delay: 0s; }
  .confetti:nth-child(2) { animation-delay: 0.3s; }
  .confetti:nth-child(3) { animation-delay: 0.6s; }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-5px) rotate(10deg); }
  }

  .announcement-content {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .announcement-badge {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: #fff;
    color: #92400e;
    padding: 0.35rem 0.8rem;
    border-radius: 5px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    animation: pulse-badge 2s ease-in-out infinite;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .badge-star {
    color: #f59e0b;
    animation: spin-star 3s linear infinite;
  }

  @keyframes spin-star {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes pulse-badge {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.03); }
  }

  .announcement-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .announcement-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #78350f;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .announcement-times {
    display: flex;
    gap: 0.5rem;
  }

  .time-pill {
    background: rgba(255, 255, 255, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #fff;
  }

  .announcement-cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    background: #78350f;
    color: #fef3c7;
    padding: 0.55rem 1.1rem;
    border-radius: 25px;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .cta-arrow {
    transition: transform 0.3s ease;
  }

  .announcement-banner:hover .announcement-cta {
    background: #451a03;
    transform: scale(1.02);
  }

  .announcement-banner:hover .cta-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .announcement-banner {
      padding: 0.7rem 1rem;
      gap: 0.5rem;
    }

    .confetti-wrapper {
      display: none;
    }

    .announcement-badge {
      font-size: 0.65rem;
      padding: 0.25rem 0.5rem;
    }

    .announcement-title {
      font-size: 0.9rem;
    }

    .time-pill {
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
    }

    .announcement-cta {
      font-size: 0.8rem;
      padding: 0.4rem 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .announcement-banner {
      padding: 0.6rem 0.75rem;
    }

    .announcement-content {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem;
      justify-content: center;
      align-items: center;
    }

    .announcement-info {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.3rem;
      align-items: center;
      justify-content: center;
    }

    .announcement-badge {
      font-size: 0.6rem;
      padding: 0.2rem 0.45rem;
    }

    .announcement-title {
      font-size: 0.8rem;
    }

    .announcement-times {
      flex-direction: row;
      gap: 0.3rem;
    }

    .time-pill {
      font-size: 0.65rem;
      padding: 0.1rem 0.4rem;
    }

    .announcement-cta {
      font-size: 0.7rem;
      padding: 0.35rem 0.7rem;
    }
  }

  .hero {
    background: linear-gradient(135deg, #67a0d7 0%, #151957 100%);
    color: white;
    min-height: 50vh;
    display: flex;
    align-items: center;
    text-align: center;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    font-weight: 700;
    color: white;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    opacity: 0.95;
    color: white;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .class-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .feature-card {
    padding: 0;
    text-align: center;
    transition: transform 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .feature-card:hover {
    transform: translateY(-5px);
  }

  .card-image-link {
    display: block;
    width: 100%;
    height: 240px;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card-image-link:hover .card-image {
    transform: scale(1.05);
  }

  .card-content {
    padding: 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-content h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-secondary);
  }

  .card-content p {
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .cta-section {
    text-align: center;
    padding: 3rem 0;
    background: var(--light-bg);
    border-radius: var(--radius);
  }

  .cta-section h2 {
    margin-bottom: 1rem;
    color: var(--dark-navy);
  }

  .cta-section p {
    margin-bottom: 2rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 50vh;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 1.125rem;
    }

    .hero-cta-buttons {
      flex-direction: column;
    }

    .btn {
      width: 200px;
    }
  }
</style>
