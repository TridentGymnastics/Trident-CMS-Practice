---
import { programNames as names, programPages } from '../data/programContent';
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';



// Import optimized images
import preschoolImg from '../assets/images/homepage/preschool.webp';
import eduGymImg from '../assets/images/homepage/edugym.webp';
import urbanGymImg from '../assets/images/homepage/UrbanGym.webp';
import agcSquadImg from '../assets/images/homepage/agc-squad.webp';

// Load classes data
const classesData = Object.entries(programPages).map(([slug, data]) => ({ slug, title: data.title, blurb: data.blurb }));

// Map slug to optimized images
const imageMap: Record<string, any> = {
  'preschool': preschoolImg,
  'edugym': eduGymImg,
  'urbangym': urbanGymImg,
  'agc': agcSquadImg
};
---

<Layout title="Gymnastics Classes Ringwood" description={`Discover Ringwood gymnastics classes at Trident Gymnastics, including ${names.preschool}, ${names.edugym}, ${names.urbangym} and ${names.agc}.`}>
  <section class="hero">
    <div class="container">
      <h1>Gymnastics Classes in Ringwood</h1>
      <p class="hero-subtitle">From toddlers to competitive athletes, Trident offers structured Ringwood gymnastics programs designed to build strength, confidence, and skill at every level.</p>
      <div class="hero-cta-buttons">
        <a href="https://portal.iclasspro.com/trident" class="cta-trial cta-trial--lg" target="_blank" rel="noopener" aria-label="Book a free trial">
          <span class="cta-label">Book Free Trial</span>
          <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13 5l7 7-7 7M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="/contact" class="btn btn-secondary">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="classes-overview section section-band">
    <div class="container">
      <div class="class-grid">
        {classesData.map((program) => (
          <div class="card feature-card card-accent">
            <a href={`/${program.slug}`} class="card-image-link">
              <Picture
                src={imageMap[program.slug]}
                formats={['avif', 'webp', 'jpeg']}
                widths={[320, 480, 640, 960]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt={`${program.title} program`}
                width={960}
                height={640}
                loading="lazy"
                class="card-image"
              />
            </a>
            <div class="card-content">
              <h2>{program.title}</h2>
              <p>{program.blurb}</p>
              <a href={`/${program.slug}`} class="btn">Learn More</a>
            </div>
          </div>
        ))}
      </div>
      
      <div class="cta-section">
        <h2>Ready to Get Started?</h2>
        <p>Book a free trial class to find the perfect program for your child.</p>
        <a href="https://portal.iclasspro.com/trident" class="cta-trial" target="_blank" rel="noopener" aria-label="Book a free trial">
          <span class="cta-label">Book Free Trial</span>
          <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13 5l7 7-7 7M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, #67a0d7 0%, #151957 100%);
    color: white;
    min-height: 50vh;
    display: flex;
    align-items: center;
    text-align: center;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    font-weight: 700;
    color: white;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    opacity: 0.95;
    color: white;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .class-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .feature-card {
    padding: 0;
    text-align: center;
    transition: transform 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .feature-card:hover {
    transform: translateY(-5px);
  }

  .card-image-link {
    display: block;
    width: 100%;
    height: 240px;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card-image-link:hover .card-image {
    transform: scale(1.05);
  }

  .card-content {
    padding: 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-content h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-secondary);
  }

  .card-content p {
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .cta-section {
    text-align: center;
    padding: 3rem 0;
    background: var(--light-bg);
    border-radius: var(--radius);
  }

  .cta-section h2 {
    margin-bottom: 1rem;
    color: var(--dark-navy);
  }

  .cta-section p {
    margin-bottom: 2rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 50vh;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 1.125rem;
    }

    .hero-cta-buttons {
      flex-direction: column;
    }

    .btn {
      width: 200px;
    }
  }
</style>
