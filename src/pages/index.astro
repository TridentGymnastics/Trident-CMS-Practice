---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { Picture } from 'astro:assets';
import { readFileSync } from 'fs';
import { parse } from 'yaml';
import path from 'path';

// Import new components
import AboutTrident from '../components/AboutTrident.astro';
import Testimonials from '../components/Testimonials.astro';
import OperatingHours from '../components/OperatingHours.astro';
// Seasonal holiday promo — live for Spring 2026 (21 September – 2 October).
// TODO(summer): re-comment these two imports and the blocks below once the
// Spring program finishes. See docs/HOLIDAY-PROGRAM-PLAYBOOK.md.
// import WinterHolidayPromo from '../components/WinterHolidayPromo.astro';
import SpringBlossomField from '../components/SpringBlossomField.astro';
import SpringHolidayPromo from '../components/SpringHolidayPromo.astro';

// Import optimized images
import preschoolImg from '../assets/images/homepage/preschool.jpg';
import eduGymImg from '../assets/images/homepage/edugym.jpg';
import urbanGymImg from '../assets/images/homepage/UrbanGym.jpg';
import agcSquadImg from '../assets/images/homepage/agc-squad.jpeg';
import heroImage1 from '../assets/images/homepage/hero-1.jpg';
import heroImage2 from '../assets/images/homepage/hero-2.jpg';

// Load assets from CMS
let assets = { hero_image: null };
try {
  const assetsPath = path.join(process.cwd(), 'content', 'assets.yml');
  const assetsFile = readFileSync(assetsPath, 'utf8');
  assets = parse(assetsFile);
} catch (error) {
  // Assets file doesn't exist or is empty, use defaults
}

const heroImageUrl = assets.hero_image ? `/uploads/${assets.hero_image}` : null;
---

<Layout
  title="Home"
  description="Book a free trial at Trident Gymnastics in Ringwood. Safe, supportive gymnastics classes for toddlers, preschoolers and school-age children."
>
  <!--
    Preload the hero video poster (desktop LCP candidate).
    On mobile the video slide is hidden; the first image slide is the LCP and
    already has fetchpriority="high" on its <img> tag.
  -->
  <link
    rel="preload"
    as="image"
    href="/Images/Homepage/compressed-Hero_1.webp"
    fetchpriority="high"
    media="(min-width: 769px)"
    slot="head"
  />
  <!--
    ==============================================
    ALERT BANNERS (HIDDEN — uncomment to re-enable)
    To show banners again: remove the opening and closing comment markers
    around the <div class="alert-banners"> block below, then update the
    dates and messages as needed.

    Available banner styles:
      - alert-banner--holiday  (blue)   → public holidays / closures
      - alert-banner--weather  (red)    → extreme weather / urgent cancellations
      - alert-banner--announcement (green) → positive news / new programs
    ==============================================
  -->
  <!--
  <div class="alert-banners">
    <div class="alert-banner alert-banner--holiday" role="alert" aria-live="polite">
      <div class="alert-content">
        <div class="alert-text">
          <span class="alert-date">Monday 26 January</span>
          <span class="alert-message">Closed for Australia Day public holiday</span>
        </div>
      </div>
    </div>

    <div class="alert-banner alert-banner--weather" role="alert" aria-live="polite">
      <div class="alert-content">
        <div class="alert-text">
          <span class="alert-date">Tuesday 27 January</span>
          <span class="alert-message">All classes cancelled due to extreme weather</span>
        </div>
      </div>
    </div>
  </div>
  -->

  <!-- Legacy announcement banners retained for reference while the autumn holiday feature is live.
       The JuniorGym morning-classes banner that used to sit here was removed with the program.
  <div class="announcement-banners-container">
    <a href="/playgym" class="announcement-banner announcement-banner--playgym">
      <div class="announcement-balloons">
        <span class="balloon">🎈</span>
        <span class="balloon">🌟</span>
        <span class="balloon">🎈</span>
      </div>
      <div class="announcement-content">
        <span class="announcement-badge announcement-badge--cyan">NEW</span>
        <span class="announcement-text">
          <strong>Monday PlayGym!</strong>
          <span class="announcement-details">11am - 12:30pm • Drop in!</span>
        </span>
        <span class="announcement-cta announcement-cta--cyan">Learn More →</span>
      </div>
      <div class="announcement-balloons">
        <span class="balloon">🎈</span>
        <span class="balloon">🌟</span>
        <span class="balloon">🎈</span>
      </div>
    </a>
  </div>
  -->

  <section class="hero section">
    <div class="hero-background">
      <!-- Dynamic Multi-Media Carousel -->
      <div class="hero-carousel">
        <!-- Video Slide 1 - Lazy loaded to save 13MB on initial page load -->
        <div class="hero-slide hero-video-slide active" data-type="video" data-duration="12000">
          <video
            class="hero-video"
            muted
            playsinline
            loop
            poster="/Images/Homepage/compressed-Hero_1.webp"
            aria-hidden="true"
            preload="none"
            data-lazy-video="/Images/Homepage/Video/Hoz_vid_1_optimised.mp4"
            data-hero-video="1"
          >
            <!-- Source added dynamically by lazy-video.ts -->
          </video>
        </div>

        <!-- Image Slide 1 (Ken Burns zoom-in-right) -->
        <div class="hero-slide hero-image-slide" data-type="image" data-duration="8000">
          <Picture
            src={heroImage1}
            formats={['avif', 'webp', 'jpeg']}
            widths={[640, 1024, 1920, 2560]}
            sizes="100vw"
            alt="Trident Gymnastics Ringwood facility"
            width={1920}
            height={1080}
            loading="eager"
            fetchpriority="high"
            class="hero-bg-image ken-burns-zoom-in-right"
          />
        </div>

        <!-- Video Slide 2 - Lazy loaded to save 6.7MB -->
        <div class="hero-slide hero-video-slide" data-type="video" data-duration="12000">
          <video
            class="hero-video"
            muted
            playsinline
            loop
            poster="/Images/Homepage/compressed-Hero_2.webp"
            aria-hidden="true"
            preload="none"
            data-lazy-video="/Images/Homepage/Video/Hoz_vid_2_optimised.mp4"
            data-hero-video="2"
          >
            <!-- Source added dynamically by lazy-video.ts -->
          </video>
        </div>

        <!-- Image Slide 2 (Ken Burns zoom-in-left) -->
        <div class="hero-slide hero-image-slide" data-type="image" data-duration="8000">
          <Picture
            src={heroImage2}
            formats={['avif', 'webp', 'jpeg']}
            widths={[640, 1024, 1920, 2560]}
            sizes="100vw"
            alt="Trident Gymnastics Ringwood facility"
            width={1920}
            height={1080}
            loading="lazy"
            decoding="async"
            class="hero-bg-image ken-burns-zoom-in-left"
          />
        </div>
      </div>
      <div class="hero-overlay"></div>
    </div>
    {/* Spring hero blossom — live with the Spring holiday program. TODO(summer): re-comment when the program finishes. */}
    <div style="position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden;">
      <SpringBlossomField />
    </div>
    <div class="container hero-content">
      <h1 id="hero-title" data-edit-file="src/pages/index.astro" data-edit-field="hero_title">Gymnastics for confident, active kids in Ringwood</h1>
      <div class="hero-tagline-main" id="hero-subtitle" data-edit-file="src/pages/index.astro" data-edit-field="hero_subtitle" aria-label="Empower with movement">
        <span class="empower">EMPOWER</span>
        <span class="with">with</span>
        <span class="movement">MOVEMENT</span>
      </div>
      <p class="hero-local-copy">Help your child build strength, coordination and confidence in a safe, supportive gymnastics club on Maroondah Highway.</p>
      <div class="cta-buttons">
        <a href="https://portal.iclasspro.com/trident" class="cta-trial cta-trial--lg cta-pulse" target="_blank" rel="noopener" aria-label="Book your free trial class">
          <span class="cta-label">Book Free Trial</span>
          <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13 5l7 7-7 7M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="#classes" class="btn btn-secondary smooth-scroll">View Classes</a>
      </div>
    </div>
  </section>

  <!-- ── Find a Class ── -->
  <section class="find-class-section">
    <div class="container">
      <div class="find-class-banner">
        <div class="find-class-text">
          <p class="find-class-kicker">Guided class finder</p>
          <h2 class="find-class-heading">Not sure where to start?</h2>
          <p class="find-class-sub">Tell us a little about your child and we&apos;ll help you choose the right starting point, from PlayGym to school-age classes.</p>
        </div>

        <button type="button" class="find-class-cta" data-open-class-selector aria-label="Find the right class">
          Find a Class
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M13 5l7 7-7 7M5 12h14"/></svg>
        </button>
      </div>
    </div>
  </section>

  {/*
  ==============================================================
  SEASONAL HOLIDAY PROMO — live for Spring 2026.
  TODO(summer): to hide it once the program finishes —
    1. Re-comment `import SpringHolidayPromo` at the top of this file.
    2. Re-comment the <SpringHolidayPromo /> block below.
    3. Set holidayProgramStatus.live: false in src/data/holidayPrograms.ts.
  See docs/HOLIDAY-PROGRAM-PLAYBOOK.md for the full checklist.
  ==============================================================
  */}
  <div class="container">
    <SpringHolidayPromo />
  </div>

  <section class="features section section-band" id="classes" aria-labelledby="classes-heading">
    <div class="container">
      <h2 id="classes-heading" data-edit-file="src/pages/index.astro" data-edit-field="classes_title">Recreational gymnastics classes in Ringwood</h2>
      <p class="section-intro">From preschool movement to school-age gymnastics, Trident offers coached programs where children can learn skills, build confidence and enjoy moving with support.</p>
      <div class="feature-grid">
        <div class="card feature-card card-accent">
          <a href="/preschool" class="card-image-link">
            <Picture
              src={preschoolImg}
              formats={['avif', 'webp', 'jpeg']}
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              alt="Preschool gymnastics program"
              width={960}
              height={640}
              loading="lazy"
              decoding="async"
              class="card-image"
            />
            <span class="age-badge">Ages 3½-7</span>
          </a>
          <div class="card-content">
            <h3 id="preschool-title" data-edit-file="src/pages/index.astro" data-edit-field="preschool_title">Preschool</h3>
            <p id="preschool-description" data-edit-file="src/pages/index.astro" data-edit-field="preschool_description">EduGym Adventurers and EduGym Foundation — a warm, structured introduction to gymnastics for kinder and Prep children, building balance, coordination and confidence.</p>
            <a href="/preschool" class="btn">Learn More</a>
          </div>
        </div>
        <div class="card feature-card card-accent">
          <a href="/edugym" class="card-image-link">
            <Picture
              src={eduGymImg}
              formats={['avif', 'webp', 'jpeg']}
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              alt="EduGym program"
              width={960}
              height={640}
              loading="lazy"
              decoding="async"
              class="card-image"
            />
            <span class="age-badge">Ages 5+</span>
          </a>
          <div class="card-content">
            <h3 id="edugym-title" data-edit-file="src/pages/index.astro" data-edit-field="edugym_title">EduGym</h3>
            <p id="edugym-description" data-edit-file="src/pages/index.astro" data-edit-field="edugym_description">Curriculum-aligned movement for school groups, helping children develop physical confidence, coordination and fundamental movement skills.</p>
            <a href="/edugym" class="btn">Learn More</a>
          </div>
        </div>
        <div class="card feature-card card-accent">
          <a href="/urbangym" class="card-image-link">
            <Picture
              src={urbanGymImg}
              formats={['avif', 'webp', 'jpeg']}
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              alt="UrbanGym program"
              width={960}
              height={640}
              loading="lazy"
              decoding="async"
              class="card-image"
            />
            <span class="age-badge">Ages 5+</span>
          </a>
          <div class="card-content">
            <h3 id="urbangym-title" data-edit-file="src/pages/index.astro" data-edit-field="urbangym_title">UrbanGym</h3>
            <p id="urbangym-description" data-edit-file="src/pages/index.astro" data-edit-field="urbangym_description">Urban-inspired flipping, vaulting and creative movement for children who love safe challenge, strength and skill-building.</p>
            <a href="/urbangym" class="btn">Learn More</a>
          </div>
        </div>
        <div class="card feature-card card-accent">
          <a href="/agc" class="card-image-link">
            <Picture
              src={agcSquadImg}
              formats={['avif', 'webp', 'jpeg']}
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              alt="AGC Squad program"
              width={960}
              height={640}
              loading="lazy"
              decoding="async"
              class="card-image"
            />
            <span class="age-badge age-badge--invite">Invitation Only</span>
          </a>
          <div class="card-content">
            <h3 id="agc-title" data-edit-file="src/pages/index.astro" data-edit-field="agc_title">AGC</h3>
            <p id="agc-description" data-edit-file="src/pages/index.astro" data-edit-field="agc_description">An invitation-only pathway for gymnasts ready for a more focused Australian Gymnastics Club training stream.</p>
            <a href="/agc" class="btn">Learn More</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="features section" id="other-programs" aria-labelledby="programs-heading">
    <div class="container">
      <h2 id="programs-heading" data-edit-file="src/pages/index.astro" data-edit-field="programs_title">PlayGym, recreational gymnastics and birthday parties</h2>
      <p class="section-intro">Families can choose from playful early-years movement, weekly gymnastics classes and active birthday parties at our Ringwood facility.</p>
      <div class="feature-grid">
        <div class="card feature-card card-accent">
          <div class="card-content">
            <h3 id="playgym-title" data-edit-file="src/pages/index.astro" data-edit-field="playgym_title">PlayGym <span class="age-label">Ages 0-6</span></h3>
            <p id="playgym-description" data-edit-file="src/pages/index.astro" data-edit-field="playgym_description">For toddlers and preschoolers building confidence through movement, climbing, balancing and play. A warm introduction to gymnastics in a fun, age-appropriate environment.</p>
            <a href="/playgym" class="btn">Learn More</a>
          </div>
        </div>
        <div class="card feature-card card-accent">
          <div class="card-content">
            <h3 id="parties-title" data-edit-file="src/pages/index.astro" data-edit-field="parties_title">Birthday Parties <span class="age-label age-label--all">All Ages</span></h3>
            <p id="parties-description" data-edit-file="src/pages/index.astro" data-edit-field="parties_description">A high-energy gymnastics party where children can run, jump, swing and celebrate in a safe, supervised space.</p>
            <a href="/parties" class="btn">Learn More</a>
          </div>
        </div>
        {/* Holiday Programs card — live with the Spring program. TODO(summer): re-comment when it finishes. */}
        <div class="card feature-card card-accent">
          <div class="card-content">
            <h3 id="holiday-title" data-edit-file="src/pages/index.astro" data-edit-field="holiday_title">Holiday Programs <span class="age-label">Ages 5+</span></h3>
            <p id="holiday-description" data-edit-file="src/pages/index.astro" data-edit-field="holiday_description">Active school holiday sessions that help children keep moving, try new skills and enjoy coached gym time during the break.</p>
            <a href="/school-holidays" class="btn">Learn More</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="why-choose section" id="why-choose" aria-labelledby="why-choose-heading">
    <div class="container">
      <h2 id="why-choose-heading">Why Choose Trident Gymnastics?</h2>
      <div class="stats-row">
        <div class="stat-item">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
              <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
              <path d="M4 22h16"/>
              <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
              <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
              <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
            </svg>
          </div>
          <div class="stat-content">
            <h3>New Club 2022</h3>
            <p>Gymnastics Victoria</p>
          </div>
        </div>

        <div class="stat-item">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/>
              <path d="M12 8l1.5 3 3 .5-2.2 2 .5 3L12 15l-2.8 1.5.5-3-2.2-2 3-.5L12 8z"/>
            </svg>
          </div>
          <div class="stat-content">
            <h3>Small Club 2023</h3>
            <p>Gymnastics Victoria</p>
          </div>
        </div>

        <div class="stat-item">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3v18h18"/>
              <path d="M3 12h4v9H3z"/>
              <path d="M10 8h4v13h-4z"/>
              <path d="M17 5h4v16h-4z"/>
            </svg>
          </div>
          <div class="stat-content">
            <h3>1000sqm Facility</h3>
            <p>Fully Equipped</p>
          </div>
        </div>

        <div class="stat-item">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
          </div>
          <div class="stat-content">
            <h3>Unique UrbanGym</h3>
            <p>Urban-Inspired Movement</p>
          </div>
        </div>

        <div class="stat-item">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <div class="stat-content">
            <h3>Family Feedback</h3>
            <p>Shared by parents</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof -->
  <Testimonials />

  <!-- NEW: About Trident - Mission, Values, and Community -->
  <AboutTrident />

  <!-- NEW: Operating Hours & Contact Information -->
  <OperatingHours />
</Layout>

<style>
  /* Alert Banners Container */
  .alert-banners {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 10;
  }

  /* Base Alert Banner */
  .alert-banner {
    padding: 0.9rem 1.5rem;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  .alert-content {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .alert-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .alert-date {
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .alert-message {
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* Holiday Notice - Blue theme */
  .alert-banner--holiday {
    background: linear-gradient(135deg, #1a5490 0%, #1e6bb8 100%);
    border-bottom: 2px solid #134a7a;
  }

  .alert-banner--holiday .alert-date::after {
    content: ":";
  }

  /* Weather Warning - Red urgent theme */
  .alert-banner--weather {
    background: linear-gradient(135deg, #dc2626 0%, #ea580c 100%);
    border-bottom: 2px solid #b91c1c;
  }

  .alert-banner--weather .alert-date::after {
    content: " —";
  }

  /* Exciting Announcement Banner */
  .announcement-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.9rem 1.5rem;
    text-decoration: none;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .announcement-banner--homepage {
    background: linear-gradient(90deg, #059669, #10b981, #34d399, #10b981, #059669);
    background-size: 200% 100%;
    animation: shimmer 3s ease-in-out infinite;
  }

  .announcement-banner:hover {
    transform: scale(1.01);
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4);
  }

  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .announcement-sparkles {
    display: flex;
    gap: 0.3rem;
  }

  .sparkle {
    font-size: 0.9rem;
    animation: twinkle 1.5s ease-in-out infinite;
    color: #fef08a;
  }

  .sparkle:nth-child(2) { animation-delay: 0.3s; }
  .sparkle:nth-child(3) { animation-delay: 0.6s; }

  @keyframes twinkle {
    0%, 100% { opacity: 0.4; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .announcement-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .announcement-badge {
    background: #fef08a;
    color: #065f46;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    animation: pulse-badge 2s ease-in-out infinite;
  }

  @keyframes pulse-badge {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .announcement-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .announcement-text strong {
    font-size: 1rem;
    font-weight: 700;
  }

  .announcement-details {
    font-size: 0.9rem;
    opacity: 0.95;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .announcement-cta {
