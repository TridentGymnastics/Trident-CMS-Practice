    font-weight: 600;
    background: rgba(255, 255, 255, 0.2);
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    transition: all 0.3s ease;
  }

  .announcement-banner:hover .announcement-cta {
    background: rgba(255, 255, 255, 0.35);
    transform: translateX(3px);
  }

  /* Container for multiple announcement banners */
  .announcement-banners-container {
    display: flex;
    flex-direction: column;
  }

  /* PlayGym Banner - Cyan/Teal theme */
  .announcement-banner--playgym {
    background: linear-gradient(90deg, #0891b2, #06b6d4, #22d3ee, #06b6d4, #0891b2);
    background-size: 200% 100%;
    animation: shimmer-cyan 3s ease-in-out infinite;
  }

  .announcement-banner--playgym:hover {
    box-shadow: 0 4px 20px rgba(6, 182, 212, 0.4);
