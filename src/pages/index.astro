  .hero {
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: none;
    margin-left: 50%;
    transform: translateX(-50%);
    min-height: clamp(620px, 82svh, 820px);
    display: flex;
    align-items: center;
    color: white;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  /* Hero Carousel Container */
  .hero-carousel {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Hero Slide Base */
  .hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: scale(1.0);
    transition: opacity 2.5s ease-in-out, transform 2.5s ease-in-out;
    z-index: 1;
  }

  .hero-slide.active {
    opacity: 1;
    transform: scale(1.0);
  }

  .hero-slide.transitioning-out {
    opacity: 0;
    transform: scale(1.16);
  }

  /* Video Slide */
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Image Slide */
  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Ken Burns Animations */
  @keyframes kenBurnsZoomInRight {
    0% {
      transform: scale(1.0) translateX(0);
    }
    100% {
      transform: scale(1.15) translateX(2%);
    }
  }

  @keyframes kenBurnsZoomInLeft {
    0% {
      transform: scale(1.0) translateX(0);
    }
    100% {
      transform: scale(1.15) translateX(-2%);
    }
  }

  /* Apply Ken Burns to active image slides */
  .hero-slide.active .ken-burns-zoom-in-right {
    animation: kenBurnsZoomInRight 8s ease-out forwards;
  }

  .hero-slide.active .ken-burns-zoom-in-left {
    animation: kenBurnsZoomInLeft 8s ease-out forwards;
  }

  /* Mobile: Hide videos, show only images with Ken Burns */
  @media (max-width: 768px) {
    .hero-video-slide {
      display: none;
    }
    /* Show the first image slide immediately before JS carousel initialises.
       Slide 0 is always a video (hidden above), slide 1 is always the first image. */
    .hero-carousel .hero-slide:nth-child(2) {
      opacity: 1;
    }
  }

  /* Reduced Motion: Static images only, no Ken Burns */
  @media (prefers-reduced-motion: reduce) {
    .hero-video-slide {
      display: none;
    }

    .ken-burns-zoom-in-right,
    .ken-burns-zoom-in-left {
      animation: none !important;
    }
  }

  .hero-overlay {
