  /* CTA Pulse Animation */
  @keyframes cta-pulse {
    0% {
      box-shadow: 0 6px 16px rgba(11, 17, 80, 0.18), 0 0 0 0 rgba(255, 211, 59, 0.7);
    }
    50% {
      box-shadow: 0 10px 24px rgba(11, 17, 80, 0.28), 0 0 0 15px rgba(255, 211, 59, 0);
    }
    100% {
      box-shadow: 0 6px 16px rgba(11, 17, 80, 0.18), 0 0 0 0 rgba(255, 211, 59, 0);
    }
  }

  .cta-pulse {
    animation: cta-pulse 2s ease-out 1s 3;
  }

  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .cta-pulse {
      animation: none;
    }
  }

