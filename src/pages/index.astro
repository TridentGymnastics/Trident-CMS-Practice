      display: block;
      margin-top: 0.5rem;
      width: fit-content;
    }

    /* Stats section for very small screens */
    .stat-icon {
      width: 40px;
      height: 40px;
    }

    .stat-content h3 {
      font-size: 1rem;
    }

    .stat-content p {
      font-size: 0.85rem;
    }

    .why-choose {
      padding: 3rem 0;
    }

    .why-choose h2 {
      font-size: 1.75rem;
      margin-bottom: 2rem;
    }
  }
</style>

<script>
  // Dynamic Hero Carousel (videos + images with Ken Burns)
  function initHeroCarousel() {
    const slides = document.querySelectorAll('.hero-slide');
    if (slides.length <= 1) return;

    const isMobileView = () => window.matchMedia('(max-width: 768px)').matches;

    let currentSlide = 0;
    let isTransitioning = false;

    function goToSlide(index: number) {
      if (isTransitioning) return;
      isTransitioning = true;

      // Stop current video if it's playing
      const currentVideo = slides[currentSlide].querySelector('.hero-video') as HTMLVideoElement | null;
      if (currentVideo) {
        currentVideo.pause();
        currentVideo.currentTime = 0;
      }

      // Fade out current slide
      slides[currentSlide].classList.add('transitioning-out');
      setTimeout(() => {
        slides[currentSlide].classList.remove('active', 'transitioning-out');
      }, 100);

      currentSlide = index;

      // Fade in new slide
      setTimeout(() => {
        slides[currentSlide].classList.add('active');
      }, 100);

      const slideType = slides[currentSlide].getAttribute('data-type');
      const duration = parseInt(slides[currentSlide].getAttribute('data-duration') || '8000');

      if (slideType === 'video' && isMobileView()) {
        // Video slides are hidden on mobile — skip immediately to next visible slide
        isTransitioning = false;
        nextSlide();
      } else if (slideType === 'video') {
        // Desktop video slide
        const video = slides[currentSlide].querySelector('.hero-video') as HTMLVideoElement | null;
        if (video) {
          video.play().catch(() => {
            setTimeout(() => {
              isTransitioning = false;
              nextSlide();
            }, duration);
          });

          const videoEndHandler = () => {
            video.removeEventListener('ended', videoEndHandler);
            isTransitioning = false;
            nextSlide();
          };

          const timeoutId = setTimeout(() => {
            video.removeEventListener('ended', videoEndHandler);
            isTransitioning = false;
            nextSlide();
          }, duration);

          video.addEventListener('ended', () => {
            clearTimeout(timeoutId);
            videoEndHandler();
          });
        }
      } else {
        // Image slide with Ken Burns effect
        setTimeout(() => {
          isTransitioning = false;
          nextSlide();
        }, duration);
      }
    }

    function nextSlide() {
      let nextIndex = (currentSlide + 1) % slides.length;
      // On mobile, skip past any video slides
      if (isMobileView()) {
        let guard = slides.length;
        while (slides[nextIndex].classList.contains('hero-video-slide') && guard-- > 0) {
          nextIndex = (nextIndex + 1) % slides.length;
        }
      }
      goToSlide(nextIndex);
    }

    // On mobile, start from the first image slide (slide 0 is a video, hidden on mobile)
    if (isMobileView()) {
      const firstImageIndex = Array.from(slides).findIndex(s => s.classList.contains('hero-image-slide'));
      if (firstImageIndex > 0) {
        slides[0].classList.remove('active'); // deactivate the initial video slide
        currentSlide = 0;
        goToSlide(firstImageIndex);
        return;
      }
    }

    // Start carousel from slide 0 (desktop)
    goToSlide(0);
  }

  // Smooth scroll for anchor links
  function initSmoothScroll() {
    const smoothScrollLinks = document.querySelectorAll('a[href^="#"]');

    smoothScrollLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        const href = this.getAttribute('href');
        if (href === '#') return;

        const targetId = href.substring(1);
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          e.preventDefault();

          const yOffset = -100; // Offset for fixed header
          const y = targetElement.getBoundingClientRect().top + window.pageYOffset + yOffset;

          window.scrollTo({
            top: y,
            behavior: 'smooth'
          });
        }
      });
    });
  }

  // Initialize on page load
  function init() {
    initHeroCarousel();
    initSmoothScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', init);
</script>

