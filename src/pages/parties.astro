---
import Layout from '../layouts/Layout.astro';
import UniversalHero from '../components/shared/UniversalHero.astro';
import parties from '../content/parties.json';
---
<Layout title="Gymnastics Birthday Parties Ringwood" description={parties.introduction}>
  <UniversalHero title="Gymnastics birthday parties" subtitle={parties.introduction} primaryCta="Book a party" primaryCtaHref={parties.booking_url} colorScheme="primary-secondary" />
  <section class="simple-parties">
    <h2>Party packages</h2>
    <div class="package-grid">{parties.packages.map(item => <article class="package">
      <h3>{item.name}</h3><p>{item.capacity}</p><p class="price">{item.price}</p>
    </article>)}</div>
    <p class="payment">{parties.payment_note}</p>
    <h2>Your party day</h2><p class="schedule">{parties.schedule}</p>
    <div class="details">{parties.details.map(paragraph => <p>{paragraph}</p>)}</div>
    <div class="actions"><a class="btn btn-primary" href={parties.booking_url} target="_blank" rel="noopener">View availability and book</a><a class="btn btn-secondary" href="/Parties/trident-birthday-invitation.pdf" download>Download party invitation</a></div>
  </section>
</Layout>
<style>
  .simple-parties{padding:2.5rem 1rem 3.5rem;max-width:1080px;margin:auto}.simple-parties h2{text-align:center;color:#151957;margin:2rem 0 1.25rem}.package-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:1.5rem}.package{text-align:center;padding:1.5rem;background:#fff;border:1px solid #d7e4ef;border-radius:1rem;box-shadow:0 4px 16px #1519570d}.package h3{color:#1573c2;font-size:1.35rem}.price{font-size:2rem;font-weight:700}.payment,.schedule{text-align:center;white-space:pre-line}.details{max-width:75ch;margin:1.5rem auto;line-height:1.8}.actions{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;margin-top:2rem}.actions a{text-align:center}
</style>
