---
import { programNames as names, playgym, playgymSupervision } from '../data/programContent';
import ProgramPage from '../components/ProgramPage.astro';
import { programPages } from '../data/programContent';
const program = programPages.preschool;
import { resolveProgramMedia } from '../lib/cms-media';
const media = resolveProgramMedia(program.media);
---

<ProgramPage {...program} {media}>
  <Fragment slot="after-levels">
    <section class="too-young">
      <div class="container">
        <aside class="too-young-card card" aria-labelledby="too-young-title">
          <span class="too-young-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-7-4.35-7-9.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 3.5c0 5.15-7 9.5-7 9.5z" />
            </svg>
          </span>
          <div class="too-young-text">
            <h3 id="too-young-title">Not quite old enough?</h3>
            <p>
              Our coached classes start at 3 years 6 months. For younger children, {names.playgym} offers drop-in sessions for ages {playgym.age_range}. {playgymSupervision}. No booking required.
            </p>
          </div>
          <a class="too-young-link" href="/playgym">
            <span>Explore {names.playgym}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M13 5l7 7-7 7M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </a>
        </aside>
      </div>
    </section>
  </Fragment>
</ProgramPage>

<style>
  /* Under-3½s have no coached class, so this catches those families after they have
     read the two programs. Built on the same card + right-aligned CTA shape as the
     "Try a Free Class" nudge at the foot of every program page, so it reads as part
     of the system rather than a notice bolted on. */
  .too-young {
    padding: 0 0 20px;
  }

  .too-young-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 20px 24px;
  }

  .too-young-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: rgba(21, 115, 194, 0.1);
    color: var(--color-primary, #1573c2);
  }

  .too-young-icon svg {
    width: 24px;
    height: 24px;
  }

  .too-young-text h3 {
    margin: 0 0 4px;
    color: var(--color-secondary, #151957);
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .too-young-text p {
    margin: 0;
    max-width: 60ch;
    color: var(--text-muted, #6c757d);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .too-young-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    /* 44px min touch target. */
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--color-primary, #1573c2);
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .too-young-link svg {
    width: 18px;
    height: 18px;
    transition: transform 0.18s ease;
  }

  .too-young-link:hover {
    background: #115e9e;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(21, 115, 194, 0.32);
  }

  .too-young-link:hover svg {
    transform: translateX(2px);
  }

  .too-young-link:focus-visible {
    outline: 2px solid var(--color-secondary, #151957);
    outline-offset: 3px;
  }

  /* Stack below the level cards' own breakpoint so the two never disagree. */
  @media (max-width: 768px) {
    .too-young-card {
      grid-template-columns: auto 1fr;
      gap: 16px;
      /* The text becomes several lines tall on a phone; centring would leave the
         icon floating in the middle with dead space above and below it. */
      align-items: start;
    }

    .too-young-link {
      grid-column: 1 / -1;
      justify-content: center;
    }

    .too-young-text p {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .too-young-link,
    .too-young-link svg {
      transition: none;
    }

    .too-young-link:hover {
      transform: none;
    }

    .too-young-link:hover svg {
      transform: none;
    }
  }
</style>
