---
// Fallback route for /school-holidays/skill-workshops (SEO + no-JS support)
import Layout from '../../layouts/Layout.astro';
import { holidayProgramStatus } from '../../data/holidayPrograms';

// Off-season (live: false) hides the ended schedule + booking link. See
// holidayPrograms.ts / docs/HOLIDAY-PROGRAM-PLAYBOOK.md.
const { live: programLive } = holidayProgramStatus;

const program = {
  id: 'skill-workshops',
  title: 'Skill Workshops',
  tagline: 'Master specific gymnastics skills with coaching and safe progressions',
  ageRange: '5–18 years',
  sessionLength: '1.5 hours',
  bookingType: 'Advance booking required',
  about: [
    'Skill Workshops are intensive, focused sessions designed to help gymnasts master specific techniques.',
    'Whether you\'re working on your first cartwheel or perfecting an aerial, our coaches provide personalized feedback and progression drills.',
    'These workshops target individual skills with small group sizes, ensuring every participant gets the attention they need to succeed.'
  ],
  features: [
    'Coaching focused on specific skills',
    'Small group sizes (typically 4-8 participants)',
    'Personalized attention and feedback',
    'Progressive skill development with drills',
    'Common skills: handstands, cartwheels, back handsprings, aerials, bar work',
    'UrbanGym workshops add vaults, swings, and safe flipping and tricking',
    'Great for current students or newcomers with a specific goal'
  ],
  requirements: [
    'Ages 5 to 18 years',
    'Prerequisites vary by workshop',
    'Some workshops require prior gymnastics experience',
    'Advance booking required',
    'Appropriate attire and bare feet'
  ],
  schedule: {
    days: [
      { day: 'Week 1: Monday 21 September 2026', time: '1:00 pm - 2:30 pm', title: 'Handstands & Cartwheels', description: 'Master the fundamentals with drills and apparatus-based activities designed to perfect your handstands and cartwheels.' },
      { day: 'Week 1: Wednesday 23 September 2026', time: '1:00 pm - 2:30 pm', title: 'Flips & Tricks', description: 'Work toward advanced skills like walkovers, round-offs, aerials, and flips with coaching and safe progressions.' },
      { day: 'Week 1: Thursday 24 September 2026', time: '1:00 pm - 2:30 pm', title: 'Parkour', description: 'Inspired by parkour, ninja warrior, and trampoline skills, combining agility, coordination, and adrenaline for a high-energy experience.' },
      { day: 'Week 2: Monday 28 September 2026', time: '1:00 pm - 2:30 pm', title: 'Handstands & Cartwheels', description: 'Master the fundamentals with drills and apparatus-based activities designed to perfect your handstands and cartwheels.' },
      { day: 'Week 2: Wednesday 30 September 2026', time: '1:00 pm - 2:30 pm', title: 'Flips & Tricks', description: 'Work toward advanced skills like walkovers, round-offs, aerials, and flips with coaching and safe progressions.' },
      { day: 'Week 2: Thursday 1 October 2026', time: '1:00 pm - 2:30 pm', title: 'UrbanGym', description: 'Urban-inspired movement training that builds gymnastics fundamentals, safe flipping and tricking, plus vaults, swings and creative movement in a coached environment.' }
    ],
    holiday_notice: 'Double the fun! On selected days, kids can attend a Skill Workshop and OpenGym on the same day - learn new skills, then enjoy unstructured play afterwards.'
  },
  pricing: {
    intro: 'Workshop pricing varies based on duration and skill level. Contact us for current workshop offerings and pricing.',
    items: [
      { label: 'Per Session (1.5 hr)', price: '$35' },
      { label: '2-Hour Intensive', price: 'From $45' },
      { label: 'Multi-Day Package', price: 'Custom pricing' }
    ],
    multi_visit_note: 'Package discounts available for multiple workshop bookings.'
  },
  howToJoin: {
    text: 'Browse our current workshop schedule and book your spot online or by contacting us directly.',
    note: 'Workshops fill quickly during school holidays — book early to secure your place!'
  }
};
---

<Layout
  title={programLive ? `${program.title} - Spring Holidays` : `${program.title} - School Holidays`}
  description={programLive
    ? `Coached gymnastics Skill Workshops for ages ${program.ageRange} at Trident Gymnastics Ringwood. 1:00-2:30 pm on selected dates, 21 September to 1 October 2026.`
    : `${program.tagline} Coaching-focused gymnastics workshops for ages ${program.ageRange} run each Victorian school holiday break at Trident Gymnastics Ringwood. Dates for the next program announced soon.`}
>
  <main>
    <section class="program-hero">
      <div class="container">
        <nav class="breadcrumb">
          <a href="/school-holidays">School Holidays</a>
          <span>/</span>
          <span>{program.title}</span>
        </nav>

        <h1>{program.title}</h1>
        <p class="tagline">{program.tagline}</p>

        <div class="quick-meta">
          <div class="meta-badge meta-badge--age">
            <span class="meta-badge-label">Ages</span>
            <span class="meta-badge-value">{program.ageRange}</span>
          </div>
          <div class="meta-badge">
            <span class="meta-badge-label">Session</span>
            <span class="meta-badge-value">{program.sessionLength}</span>
          </div>
          <div class="meta-badge">
            <span class="meta-badge-label">Booking</span>
            <span class="meta-badge-value">{program.bookingType}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="program-content">
      <div class="container">
        <article class="program-details">
          <section class="content-section">
            <h2>About This Program</h2>
            {program.about.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>

          <section class="content-section">
            <h2>What to Expect</h2>
            <ul class="feature-list">
              {program.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </section>

          <section class="content-section">
            <h2>Requirements</h2>
            <ul class="requirement-list">
              {program.requirements.map((req) => (
                <li>{req}</li>
              ))}
            </ul>
          </section>

          <section class="content-section">
            <h2>Schedule</h2>
            {programLive ? (
              <Fragment>
                {program.schedule.days && (
                  <div class="schedule-grid">
                    {program.schedule.days.map((slot) => (
                      <div class="schedule-item schedule-item--workshop">
                        <strong>{slot.day}</strong>
                        <span class="session-time">{slot.time}</span>
                        {slot.title && <span class="session-title">{slot.title}</span>}
                        {slot.description && <span class="session-description">{slot.description}</span>}
                      </div>
                    ))}
                  </div>
                )}
                {program.schedule.holiday_notice && (
                  <p class="notice-highlight">{program.schedule.holiday_notice}</p>
                )}
              </Fragment>
            ) : (
              <p class="notice-text">Skill Workshops run each Victorian school holiday period. Session themes and dates for the next program will be listed on our <a href="/school-holidays">School Holidays page</a> as soon as they're confirmed.</p>
            )}
          </section>

          <section class="content-section">
            <h2>Pricing</h2>
            <p>{program.pricing.intro}</p>
            <div class="pricing-grid">
              {program.pricing.items.map((item) => (
                <div class="pricing-item">
                  <span class="price-label">{item.label}</span>
                  <span class="price-value">{item.price}</span>
                </div>
              ))}
            </div>
            <p class="notice-text">{program.pricing.multi_visit_note}</p>
          </section>

          <section class="content-section">
            <h2>How to Join</h2>
            <p>{program.howToJoin.text}</p>
            <p class="notice-highlight">{program.howToJoin.note}</p>
          </section>

          <section class="cta-section">
            <div class="cta-buttons">
              {programLive ? (
                <a href="https://portal.iclasspro.com/trident/camps/9?typeId=9&next=camps&nextTitle=Holiday%20Program&pluralTitle=Holiday%20Programs&q=2026&sortBy=name" class="btn btn-primary btn-large" target="_blank" rel="noopener noreferrer">Book Now</a>
              ) : (
                <a href="/school-holidays" class="btn btn-primary btn-large">See Upcoming Programs</a>
              )}
              <a href="/school-holidays" class="btn btn-secondary btn-large">All Programs</a>
            </div>
          </section>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  .program-hero {
    background: linear-gradient(135deg, var(--dark-navy) 0%, var(--primary-blue) 100%);
    color: white;
    padding: 3rem 0 4rem;
    text-align: center;
  }

  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .breadcrumb a {
    color: white;
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    opacity: 0.8;
  }

  .breadcrumb span {
    margin: 0 0.5rem;
  }

  .program-hero h1 {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: white;
    margin-bottom: 1rem;
  }

  .tagline {
    font-size: 1.25rem;
    margin-bottom: 2.5rem;
    opacity: 0.95;
  }

  .quick-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, max-content));
    gap: 1rem;
    justify-content: center;
  }

  .meta-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    min-width: 180px;
    padding: 0.95rem 1.1rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    text-align: left;
  }

  .meta-badge--age {
    background: rgba(255, 224, 55, 0.18);
    border-color: rgba(255, 224, 55, 0.4);
  }

  .meta-badge-label {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.76);
  }

  .meta-badge-value {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .program-content {
    padding: 4rem 0;
  }

  .program-details {
    max-width: 800px;
    margin: 0 auto;
  }

  .content-section {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .content-section:last-of-type {
    border-bottom: none;
  }

  .content-section h2 {
    font-size: 2rem;
    color: var(--dark-navy);
    margin-bottom: 1.5rem;
  }

  .content-section p {
    color: var(--color-black);
    line-height: 1.65;
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .feature-list,
  .requirement-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .feature-list li,
  .requirement-list li {
    padding-left: 2rem;
    position: relative;
    line-height: 1.65;
  }

  .feature-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--primary-blue);
    font-weight: bold;
    font-size: 1.25rem;
  }

  .requirement-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--dark-navy);
    font-weight: bold;
    font-size: 1.5rem;
    line-height: 1.4;
  }

  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .schedule-item {
    background: var(--light-bg);
    padding: 1.25rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .schedule-item strong {
    color: var(--dark-navy);
    font-size: 1.1rem;
  }

  .schedule-item--workshop {
    border-left: 4px solid var(--primary-blue);
    padding-left: 1.25rem;
  }

  .session-time {
    color: var(--primary-blue);
    font-weight: 600;
  }

  .session-title {
    margin-top: 0.5rem;
    color: var(--dark-navy);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .session-description {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.5;
    margin-top: 0.25rem;
  }

  .notice-highlight {
    background: linear-gradient(135deg, rgba(255, 211, 56, 0.15), rgba(21, 115, 194, 0.08));
    border: 2px solid var(--accent-yellow);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    font-weight: 600;
    color: var(--dark-navy) !important;
    margin-top: 1.5rem !important;
    line-height: 1.6;
  }

  .notice-text {
    background: var(--light-bg);
    padding: 1rem 1.5rem;
    border-radius: 8px;
    font-size: 0.95rem !important;
    color: var(--text-muted) !important;
    font-style: italic;
  }

  .pricing-grid {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .pricing-item {
    background: var(--light-bg);
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .price-label {
    color: var(--dark-navy);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .price-value {
    color: var(--primary-blue);
    font-weight: 700;
    font-size: 1.15rem;
  }

  .cta-section {
    padding: 2.5rem 0 1rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-large {
    padding: 1rem 2rem;
    font-size: 1.1rem;
    min-width: 200px;
  }

  @media (max-width: 768px) {
    .quick-meta {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .meta-badge {
      width: 100%;
      min-width: 0;
      padding: 0.85rem 1rem;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .btn-large {
      width: 100%;
    }
  }
</style>
