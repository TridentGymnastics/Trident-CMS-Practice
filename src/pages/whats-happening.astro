---
import Layout from '../layouts/Layout.astro';
import Announcements from '../components/Announcements.astro';
---

<Layout
  title="What's Happening"
  description="News, wins and moments from around Trident Gymnastics in Ringwood — competition results, squad achievements and what's on at the gym."
>
  <section class="wh-hero" aria-labelledby="wh-title">
    <div class="container">
      <p class="wh-hero__eyebrow">News &amp; updates</p>
      <h1 id="wh-title">What&rsquo;s happening at Trident</h1>
      <p class="wh-hero__sub">
        A little window into life at the gym — competition wins, squad milestones and the
        moments that make our community special. Check back often; we update this as things happen!
      </p>
    </div>
  </section>

  <!-- Full archive — no heading here, the page supplies its own <h1> above. -->
  <Announcements heading={null} intro={null} />
</Layout>

<style>
  .wh-hero {
    padding: 2.5rem 0 0.5rem;
    text-align: center;
  }

  .wh-hero__eyebrow {
    display: inline-block;
    background: rgba(21, 115, 194, 0.1);
    color: var(--primary-blue);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    margin: 0 0 1rem;
  }

  .wh-hero h1 {
    margin-bottom: 1rem;
  }

  .wh-hero__sub {
    max-width: 60ch;
    margin: 0 auto;
    color: var(--text-muted);
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .wh-hero {
      padding-top: 1.5rem;
    }

    .wh-hero h1 {
      font-size: 2rem;
    }
  }
</style>
