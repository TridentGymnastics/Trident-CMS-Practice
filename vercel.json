{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm ci",
  "buildCommand": "ASTRO_TELEMETRY_DISABLED=1 npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Content-Security-Policy",
          "value": "form-action 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/whats-happening",
      "destination": "/",
      "permanent": true
    }
  ]
}
